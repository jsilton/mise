---
import '../styles/palettes.css';
interface Props {
  title: string;
  jsonLd?: string;
  description?: string;
  image?: string;
}

const {
  title,
  jsonLd,
  description = 'Recipes that teach you to cook. Understand the technique, recognize the cues, and build confidence in your kitchen.',
  image = new URL(
    `${import.meta.env.BASE_URL}images/dishes/authentic-roman-alfredo-watercolor.png`,
    Astro.site
  ).href,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />

    <!-- OpenGraph / Social Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}styles/print.css`} media="print" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline>
      try {
        const palette = localStorage.getItem('mise-palette');
        if (['porcelain', 'sage', 'rose'].includes(palette))
          document.documentElement.dataset.palette = palette;
      } catch {
        /* Use the default paper palette when storage is unavailable. */
      }
    </script>
    <title>{title}</title>
    <!-- eslint-disable-next-line astro/no-set-html-directive -->
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <style is:global>
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 145px;
        color-scheme: light;
      }
      [hidden] {
        display: none !important;
      }
      :focus-visible {
        outline: 2px solid var(--accent-gold-bright);
        outline-offset: 4px;
      }
      .eyebrow {
        font-size: 0.66rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        font-weight: 600;
        color: var(--accent-gold);
      }
      .breadcrumb {
        display: flex;
        gap: 0.7rem;
        font-size: 0.8rem;
        color: var(--text-secondary);
      }
      .breadcrumb a:hover {
        color: var(--accent-gold);
      }
      .skip-link {
        position: fixed;
        top: -100px;
        left: 1rem;
        z-index: 100;
        background: var(--accent-gold);
        color: var(--bg-deep);
        padding: 0.8rem 1rem;
      }
      .skip-link:focus {
        top: 0.5rem;
      }
      .site-nav a {
        font-size: 0.8rem;
        color: var(--text-secondary);
        padding: 0.65rem 0.7rem;
        border-bottom: 2px solid transparent;
      }
      .site-nav a:hover,
      .site-nav a[aria-current='page'] {
        color: var(--text-primary);
        border-bottom-color: var(--accent-gold);
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          transition: none !important;
          animation: none !important;
        }
      }
      @media (max-width: 760px) {
        html {
          scroll-padding-top: 215px;
        }
      }
      @media (max-width: 440px) {
        .site-nav a {
          padding: 0.65rem 0.45rem;
          font-size: 0.75rem;
        }
      }
      /* ───────────────────────────────────
       * Typography System — Prose Refined
       * Cormorant Garamond headings + Inter body
       * ─────────────────────────────────── */

      /* Headings - Clear hierarchy with serif display */
      .prose-refined h2 {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        padding-bottom: 0.625rem;
        border-bottom: 1px solid var(--border-subtle);
        line-height: 1.3;
      }
      .prose-refined h2:first-child {
        margin-top: 0;
      }

      .prose-refined h3 {
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        line-height: 1.3;
      }

      /* Paragraphs */
      .prose-refined p {
        font-size: 1rem;
        color: var(--text-secondary);
        line-height: 1.8;
        margin-bottom: 1.25em;
      }

      /* Strong and emphasis */
      .prose-refined strong {
        font-weight: 500;
        color: var(--text-primary);
      }
      .prose-refined em {
        font-style: italic;
        color: var(--text-secondary);
      }

      /* Unordered lists */
      .prose-refined ul {
        list-style: none;
        padding-left: 0;
        margin-top: 0.5rem;
        margin-bottom: 1.5rem;
      }
      .prose-refined ul li {
        position: relative;
        padding-left: 1.25rem;
        font-size: 1rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 0.375rem;
      }
      .prose-refined ul li::before {
        content: '•';
        position: absolute;
        left: 0;
        color: var(--text-tertiary);
        font-weight: 600;
      }
      .prose-refined ul li a {
        font-weight: 600;
      }
      .prose-refined ul li em {
        color: var(--text-tertiary);
        font-style: normal;
        font-size: 0.875rem;
      }

      /* Ordered lists (recipe directions) */
      .prose-refined ol {
        list-style: none;
        padding-left: 0;
        margin-top: 0.75rem;
        margin-bottom: 1.5rem;
        counter-reset: step-counter;
      }
      .prose-refined ol li {
        position: relative;
        padding-left: 2rem;
        font-size: 1rem;
        color: var(--text-secondary);
        line-height: 1.8;
        margin-bottom: 0.75rem;
        counter-increment: step-counter;
      }
      .prose-refined ol li::before {
        content: counter(step-counter) '.';
        position: absolute;
        left: 0;
        top: 0;
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--accent-gold);
        width: 1.5rem;
      }
      .prose-refined ol li strong:first-child {
        font-weight: 600;
        color: var(--text-primary);
      }

      /* Links */
      .prose-refined a {
        color: var(--accent-link);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.15s ease;
      }
      .prose-refined a:hover {
        color: var(--accent-link-bright);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      /* Tables */
      .prose-refined table {
        width: 100%;
        margin: 1.5rem 0;
        font-size: 0.875rem;
        border-radius: 0.5rem;
        overflow: hidden;
        background: var(--bg-elevated);
        border: 1px solid var(--border-subtle);
      }
      .prose-refined thead {
        background: var(--bg-deep);
      }
      .prose-refined thead tr {
        border-bottom: 1px solid var(--border-subtle);
      }
      .prose-refined th {
        padding: 0.75rem 1rem;
        text-align: left;
        font-size: 0.6875rem;
        font-weight: 700;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .prose-refined td {
        padding: 0.625rem 1rem;
        color: var(--text-secondary);
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border-subtle);
        line-height: 1.5;
      }
      .prose-refined tbody tr:last-child td {
        border-bottom: none;
      }
      .prose-refined td:first-child {
        font-weight: 600;
        color: var(--text-primary);
      }

      /* Horizontal rule */
      .prose-refined hr {
        border: none;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--border-emphasis), transparent);
        margin: 2.5rem 0;
      }

      /* Block quotes */
      .prose-refined blockquote {
        margin: 1.5rem 0;
        padding: 1rem 1.25rem;
        background: rgba(201, 169, 97, 0.06);
        border-left: 3px solid var(--accent-gold-muted);
        border-radius: 0 0.375rem 0.375rem 0;
      }
      .prose-refined blockquote p {
        margin-bottom: 0;
        font-size: 0.875rem;
        color: var(--accent-gold-bright);
      }

      /* Code inline */
      .prose-refined code {
        font-size: 0.875em;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        background: var(--bg-elevated);
        padding: 0.125rem 0.375rem;
        border-radius: 0.25rem;
        color: var(--text-secondary);
      }
    </style>
  </head>
  <body
    class="min-h-screen flex flex-col font-sans antialiased"
    style="background-color: var(--bg-deep); color: var(--text-primary);"
  >
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header
      class="sticky top-0 z-20"
      style="background: var(--bg-deep); border-bottom: 1px solid var(--border-subtle);"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a
          href={import.meta.env.BASE_URL}
          aria-label="Mise home"
          style="font:500 2.2rem/1 'Cormorant Garamond',Georgia,serif; letter-spacing:-.06em;"
          >mise<span style="color:var(--accent-gold)">.</span></a
        >
        <nav class="site-nav flex items-center" aria-label="Main navigation">
          {
            [
              ['Recipes', ''],
              ['Learn', 'learn'],
              ['Meals', 'meals'],
            ].map(([label, path]) => (
              <a
                href={`${import.meta.env.BASE_URL}${path}`}
                aria-current={
                  path
                    ? Astro.url.pathname.startsWith(`${import.meta.env.BASE_URL}${path}`)
                      ? 'page'
                      : undefined
                    : Astro.url.pathname === import.meta.env.BASE_URL
                      ? 'page'
                      : undefined
                }
              >
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main
      id="main-content"
      tabindex="-1"
      class="flex-grow w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10"
    >
      <slot />
    </main>

    <footer
      style="border-top: 1px solid var(--border-subtle); background-color: var(--bg-deep);"
      class="mt-auto"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex flex-col md:flex-row justify-between items-center gap-3">
          <p class="text-xs" style="color: var(--text-tertiary);">
            &copy; {new Date().getFullYear()} Mise. All rights reserved.
          </p>
          <div
            class="flex flex-wrap justify-center gap-2 text-xs"
            style="color: var(--text-tertiary);"
          >
            <a href={`${import.meta.env.BASE_URL}standards`}>How we review recipes</a>
            <span aria-hidden="true"> · </span>
            <a href={`${import.meta.env.BASE_URL}style-guide`}>Our visual identity</a>
            <span style="color: var(--border-emphasis);">·</span>
            <a href={`${import.meta.env.BASE_URL}learn`}>The learning kitchen</a>
            <span style="color: var(--border-emphasis);">·</span>
            <span>Cook with understanding.</span>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Keyboard shortcuts
      document.addEventListener('keydown', (e) => {
        if ((e.target as HTMLElement)?.closest('input, textarea, select, [contenteditable="true"]'))
          return;
        // Forward slash or Cmd+K to focus search
        if ((e.key === '/' || (e.metaKey && e.key === 'k')) && !e.ctrlKey) {
          const searchInput = document.getElementById('searchInput');
          if (searchInput) {
            e.preventDefault();
            searchInput.focus();
            searchInput.select();
          }
        }

        // Escape to clear search
        if (e.key === 'Escape') {
          const searchInput = document.getElementById('searchInput');
          if (searchInput && searchInput.value) {
            searchInput.value = '';
            window.applyFiltersAndSort?.();
          }
        }
      });
    </script>
  </body>
</html>
