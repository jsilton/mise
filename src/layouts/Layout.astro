---
import '../styles/palettes.css';
interface Props {
  title: string;
  jsonLd?: string;
  description?: string;
  image?: string;
}

const {
  title,
  jsonLd,
  description = 'Recipes that teach you to cook. Understand the technique, recognize the cues, and build confidence in your kitchen.',
  image = new URL(
    `${import.meta.env.BASE_URL}images/dishes/authentic-roman-alfredo-watercolor.png`,
    Astro.site
  ).href,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />

    <!-- OpenGraph / Social Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}styles/print.css`} media="print" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..600&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <!-- eslint-disable-next-line astro/no-set-html-directive -->
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <style is:global>
      html {
        /* A touch larger than the browser default: recipes are read from a phone propped on the counter. */
        font-size: 106.25%;
        scroll-behavior: smooth;
        scroll-padding-top: 145px;
        color-scheme: light;
      }
      [hidden] {
        display: none !important;
      }
      :focus-visible {
        outline: 2px solid var(--accent-gold-bright);
        outline-offset: 4px;
      }
      .time-chip {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        padding: 0.3rem 0.75rem;
        border-radius: var(--pill);
        background: var(--time-quick);
        color: var(--on-time);
        font-size: 0.8rem;
        font-weight: 700;
        line-height: 1.25;
        max-width: 100%;
        overflow-wrap: anywhere;
      }
      .time-chip[data-band='hour'] {
        background: var(--time-hour);
      }
      .time-chip[data-band='long'] {
        background: var(--time-long);
      }
      .time-chip[data-band='none'] {
        background: transparent;
        border: 1.5px dashed var(--border-emphasis);
        color: var(--text-secondary);
        font-weight: 600;
      }
      .time-meter {
        display: inline-flex;
        gap: 3px;
        vertical-align: middle;
      }
      .time-meter i {
        width: 16px;
        height: 6px;
        border-radius: 3px;
        background: var(--border-subtle);
      }
      .time-meter[data-level='1'] i:nth-child(-n + 1),
      .time-meter[data-level='2'] i:nth-child(-n + 2),
      .time-meter[data-level='3'] i {
        background: var(--text-primary);
      }
      .breadcrumb {
        display: flex;
        gap: 0.7rem;
        font-size: 0.8rem;
        color: var(--text-secondary);
      }
      .breadcrumb a:hover {
        color: var(--accent-gold);
      }
      .skip-link {
        position: fixed;
        top: -100px;
        left: 1rem;
        z-index: 100;
        background: var(--accent-gold);
        color: var(--bg-deep);
        padding: 0.8rem 1rem;
      }
      .skip-link:focus {
        top: 0.5rem;
      }
      /* Nav links share the display face with the logo and headings. */
      .site-nav {
        gap: 0.2rem;
      }
      .site-nav a {
        font:
          650 1.08rem/1 'Fraunces',
          Georgia,
          serif;
        letter-spacing: -0.01em;
        color: var(--text-primary);
        padding: 0.55rem 0.7rem;
        border-radius: var(--pill);
      }
      .site-nav a:hover {
        background: var(--bg-elevated);
      }
      .site-nav a[aria-current='page'] {
        background: var(--apricot);
        color: var(--on-apricot);
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          transition: none !important;
          animation: none !important;
        }
      }
      @media (max-width: 760px) {
        html {
          scroll-padding-top: 215px;
        }
      }
      @media (max-width: 440px) {
        .site-nav a {
          padding: 0.5rem 0.6rem;
          font-size: 1rem;
        }
      }
      /* ───────────────────────────────────
       * Typography System — Prose Refined
       * Fraunces headings + Plus Jakarta Sans body
       * ─────────────────────────────────── */

      /* Headings - Clear hierarchy with serif display */
      .prose-refined h2 {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        line-height: 1.3;
      }
      .prose-refined h2:first-child {
        margin-top: 0;
      }

      .prose-refined h3 {
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        line-height: 1.3;
      }

      /* Paragraphs */
      .prose-refined p {
        font-size: 1rem;
        color: var(--text-secondary);
        line-height: 1.8;
        margin-bottom: 1.25em;
      }

      /* Strong and emphasis */
      .prose-refined strong {
        font-weight: 500;
        color: var(--text-primary);
      }
      .prose-refined em {
        font-style: italic;
        color: var(--text-secondary);
      }

      /* Unordered lists */
      .prose-refined ul {
        list-style: none;
        padding-left: 0;
        margin-top: 0.5rem;
        margin-bottom: 1.5rem;
      }
      .prose-refined ul li {
        position: relative;
        padding-left: 1.25rem;
        font-size: 1rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 0.375rem;
      }
      .prose-refined ul li::before {
        content: '•';
        position: absolute;
        left: 0;
        color: var(--text-tertiary);
        font-weight: 600;
      }
      .prose-refined ul li a {
        font-weight: 600;
      }
      .prose-refined ul li em {
        color: var(--text-tertiary);
        font-style: normal;
        font-size: 0.875rem;
      }

      /* Ordered lists (recipe directions) */
      .prose-refined ol {
        list-style: none;
        padding-left: 0;
        margin-top: 0.75rem;
        margin-bottom: 1.5rem;
        counter-reset: step-counter;
      }
      .prose-refined ol li {
        position: relative;
        padding-left: 2.5rem;
        font-size: 1rem;
        color: var(--text-secondary);
        line-height: 1.8;
        margin-bottom: 0.75rem;
        counter-increment: step-counter;
      }
      /* Numbered badges make the steps easy to find again from across the kitchen. */
      .prose-refined ol li::before {
        content: counter(step-counter);
        position: absolute;
        left: 0;
        top: 0.15em;
        display: grid;
        place-items: center;
        height: 1.7rem;
        border-radius: 50%;
        background: var(--wash);
        font-size: 0.85rem;
        font-weight: 700;
        line-height: 1;
        color: var(--accent-strong);
        width: 1.7rem;
      }
      .prose-refined ol li strong:first-child {
        font-weight: 600;
        color: var(--text-primary);
      }

      /* Links */
      .prose-refined a {
        color: var(--accent-link);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.15s ease;
      }
      .prose-refined a:hover {
        color: var(--accent-link-bright);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      /* Tables */
      .prose-refined table {
        width: 100%;
        margin: 1.5rem 0;
        font-size: 0.875rem;
        border-radius: 0.5rem;
        overflow: hidden;
        background: var(--bg-elevated);
        border: 1px solid var(--border-subtle);
      }
      .prose-refined thead {
        background: var(--bg-deep);
      }
      .prose-refined thead tr {
        border-bottom: 1px solid var(--border-subtle);
      }
      .prose-refined th {
        padding: 0.75rem 1rem;
        text-align: left;
        font-size: 0.6875rem;
        font-weight: 700;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .prose-refined td {
        padding: 0.625rem 1rem;
        color: var(--text-secondary);
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border-subtle);
        line-height: 1.5;
      }
      .prose-refined tbody tr:last-child td {
        border-bottom: none;
      }
      .prose-refined td:first-child {
        font-weight: 600;
        color: var(--text-primary);
      }

      /* Horizontal rule */
      .prose-refined hr {
        border: none;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--border-emphasis), transparent);
        margin: 2.5rem 0;
      }

      /* Block quotes */
      .prose-refined blockquote {
        margin: 1.5rem 0;
        padding: 1rem 1.25rem;
        background: rgba(201, 169, 97, 0.06);
        border-left: 3px solid var(--accent-gold-muted);
        border-radius: 0 0.375rem 0.375rem 0;
      }
      .prose-refined blockquote p {
        margin-bottom: 0;
        font-size: 0.875rem;
        color: var(--accent-gold-bright);
      }

      /* Code inline */
      .prose-refined code {
        font-size: 0.875em;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        background: var(--bg-elevated);
        padding: 0.125rem 0.375rem;
        border-radius: 0.25rem;
        color: var(--text-secondary);
      }

      /* The footer is a slate band, like the home hero, set in the same faces as the rest of the site. */
      .site-footer {
        background: var(--accent);
        color: #fff;
      }
      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.2rem 2rem;
        padding-top: 2.2rem;
        padding-bottom: 2.2rem;
      }
      .footer-logo {
        font:
          700 2rem/1 'Fraunces',
          Georgia,
          serif;
        letter-spacing: -0.04em;
        color: #fff;
      }
      .footer-logo span {
        color: var(--apricot);
      }
      .footer-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem 1.4rem;
      }
      .footer-nav a {
        font:
          650 1.05rem/1.3 'Fraunces',
          Georgia,
          serif;
        color: #fff;
        padding: 0.45rem 0;
      }
      .footer-nav a:hover {
        text-decoration: underline;
        text-underline-offset: 4px;
      }
      .footer-note {
        font-size: 0.85rem;
        color: #e6eef1;
        width: 100%;
        margin: 0;
      }
      .site-footer :focus-visible {
        outline-color: #fff;
      }
    </style>
  </head>
  <body
    class="min-h-screen flex flex-col font-sans antialiased"
    style="background-color: var(--bg-deep); color: var(--text-primary);"
  >
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="sticky top-0 z-20" style="background: var(--bg-deep);">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a
          href={import.meta.env.BASE_URL}
          aria-label="Mise home"
          style="font:700 2rem/1 'Fraunces',Georgia,serif; letter-spacing:-.04em;"
          >mise<span style="color:var(--apricot)">.</span></a
        >
        <nav class="site-nav flex items-center" aria-label="Main navigation">
          {
            [
              ['Recipes', ''],
              ['Learn', 'learn'],
              ['Meals', 'meals'],
            ].map(([label, path]) => (
              <a
                href={`${import.meta.env.BASE_URL}${path}`}
                aria-current={
                  path
                    ? Astro.url.pathname.startsWith(`${import.meta.env.BASE_URL}${path}`)
                      ? 'page'
                      : undefined
                    : Astro.url.pathname === import.meta.env.BASE_URL
                      ? 'page'
                      : undefined
                }
              >
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main
      id="main-content"
      tabindex="-1"
      class="flex-grow w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10"
    >
      <slot />
    </main>

    <footer class="site-footer mt-auto">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 footer-inner">
        <a href={import.meta.env.BASE_URL} class="footer-logo" aria-label="Mise home"
          >mise<span>.</span></a
        >
        <nav class="footer-nav" aria-label="Footer">
          <a href={import.meta.env.BASE_URL}>Recipes</a>
          <a href={`${import.meta.env.BASE_URL}learn`}>Learn</a>
          <a href={`${import.meta.env.BASE_URL}meals`}>Meals</a>
          <a href={`${import.meta.env.BASE_URL}standards`}>How we review recipes</a>
        </nav>
        <p class="footer-note">&copy; {new Date().getFullYear()} Mise</p>
      </div>
    </footer>

    <script>
      // Keyboard shortcuts
      document.addEventListener('keydown', (e) => {
        if ((e.target as HTMLElement)?.closest('input, textarea, select, [contenteditable="true"]'))
          return;
        // Forward slash or Cmd+K to focus search
        if ((e.key === '/' || (e.metaKey && e.key === 'k')) && !e.ctrlKey) {
          const searchInput = document.getElementById('searchInput');
          if (searchInput) {
            e.preventDefault();
            searchInput.focus();
            searchInput.select();
          }
        }

        // Escape to clear search
        if (e.key === 'Escape') {
          const searchInput = document.getElementById('searchInput');
          if (searchInput && searchInput.value) {
            searchInput.value = '';
            window.applyFiltersAndSort?.();
          }
        }
      });
    </script>
  </body>
</html>
