---
interface Props {
  sources: { title: string; url: string }[];
}
const { sources } = Astro.props;
---

<h2>Sources & recipe notes</h2>
<p>
  Technique and safety references inform the guidance; they do not certify this recipe or document a
  kitchen test.
</p>
<ul>
  {
    sources.map((source) => (
      <li>
        <a href={source.url}>{source.title} ↗</a>
      </li>
    ))
  }
</ul>
