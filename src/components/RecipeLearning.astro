---
import type { CollectionEntry } from 'astro:content';
import { getTechniquesForRecipe } from '../data/techniques';
interface Props {
  recipe: CollectionEntry<'recipes'>;
}
const { recipe } = Astro.props;
const lessons = getTechniquesForRecipe(recipe);
const BASE = import.meta.env.BASE_URL;
---

{
  lessons.length > 0 && (
    <div class="lesson-links" aria-label="Related cooking lessons">
      <span>Understand the technique</span>
      {lessons.map((t) => (
        <a href={`${BASE}learn/${t.slug}`}>
          {t.title} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  )
}
<style>
  .lesson-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.3rem;
    font-size: 0.8rem;
    align-items: center;
    padding: 0.7rem 0;
  }
  .lesson-links > span {
    color: var(--text-secondary);
  }
  a {
    color: var(--accent-gold);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
