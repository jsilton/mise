---
import type { CollectionEntry } from 'astro:content';
import { getTechniquesForRecipe } from '../data/techniques';
interface Props {
  recipe: CollectionEntry<'recipes'>;
}
const { recipe } = Astro.props;
const lessons = getTechniquesForRecipe(recipe);
const BASE = import.meta.env.BASE_URL;
---

{
  lessons.length > 0 && (
    <div class="lesson-links" aria-label="Related cooking lessons">
      {lessons.map((t) => (
        <a href={`${BASE}learn/${t.slug}`}>
          {t.title} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  )
}
<style>
  /* Lesson links sit as pills, with no label above them. */
  .lesson-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.8rem 0 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 40px;
    padding: 0.4rem 0.9rem;
    border-radius: var(--pill);
    background: var(--bg-surface);
    color: var(--text-primary);
    font-weight: 700;
    font-size: 0.88rem;
  }
  a:hover {
    background: var(--bg-hover);
  }
</style>
