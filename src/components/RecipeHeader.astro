---
import DishArt from './DishArt.astro';
import { dishVisuals } from '../data/dish-visuals';
import type { CollectionEntry } from 'astro:content';
interface Props {
  recipe: CollectionEntry<'recipes'>;
  baseUrl?: string;
}
const { recipe, baseUrl = import.meta.env.BASE_URL } = Astro.props;
const { data } = recipe;
---

<div data-recipe-header class:list={{ 'has-art': !!dishVisuals[recipe.slug] }}>
  <img class="print-wordmark" src={`${baseUrl}brand/mise-wordmark.svg`} alt="mise." />
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={baseUrl}>Recipes</a><span aria-hidden="true">/</span><span
      >{data.cuisines?.[0] || 'The collection'}</span
    >
  </nav>
  <div class="recipe-intro">
    <p class="eyebrow">
      {data.learning ? 'Cook & understand' : 'From the collection'}
      <span aria-hidden="true"> / </span>
      {data.difficulty || 'All levels'}
    </p>
    <h1>{data.title}</h1>
    {data.description && <p class="recipe-description">{data.description}</p>}
    <dl class="recipe-facts">
      {
        [
          ['Prep', data.prepTime],
          ['Cook', data.cookTime],
          ['Total', data.totalTime],
          ['Serves / makes', data.servings],
        ]
          .filter(([, value]) => value)
          .map(([label, value]) => (
            <div>
              <>
                <dt>{label}</dt>
                <dd data-header-yield={label === 'Serves / makes' ? '' : undefined}>{value}</dd>
              </>
            </div>
          ))
      }
    </dl>
    {data.learning && <p class="timing-note">{data.learning.timing}</p>}
    <details class="recipe-details">
      <summary>Recipe details & dietary notes</summary>
      <dl>
        {
          [
            ['Cuisine', data.cuisines?.join(', ')],
            ['Methods', data.cookingMethods?.join(', ')],
            ['Dietary tags', data.dietary?.join(', ')],
            ['Equipment', data.equipment?.map((x) => x.replaceAll('-', ' ')).join(', ')],
            ['Make ahead', data.advancePrep?.map((x) => x.replaceAll('-', ' ')).join(', ')],
          ]
            .filter(([, value]) => value)
            .map(([label, value]) => (
              <div>
                <>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </>
              </div>
            ))
        }
      </dl>
      {
        data.dietary?.length && (
          <p>
            Tags describe the listed ingredients and noted options. Check packaged ingredients and
            substitutions for your dietary needs.
          </p>
        )
      }
    </details>
  </div>
  {
    dishVisuals[recipe.slug] && (
      <div class="recipe-art">
        <DishArt slug={recipe.slug} eager caption />
      </div>
    )
  }
</div>
<style>
  .print-wordmark {
    display: none;
  }
  .has-art {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 0 2.5rem;
    align-items: start;
  }
  .has-art .breadcrumb {
    grid-column: 1/-1;
  }
  .recipe-art {
    padding-top: 2.2rem;
  }
  .has-art h1 {
    font-size: clamp(2.4rem, 4vw, 3.5rem);
  }
  @media (max-width: 760px) {
    .has-art {
      grid-template-columns: 1fr;
    }
    .recipe-art {
      padding-top: 1rem;
    }
  }
  @media print {
    .recipe-art {
      display: none;
    }
    .has-art {
      display: block;
    }
    .print-wordmark {
      display: block;
      width: 24mm;
      height: auto;
      margin-bottom: 3mm;
    }
  }
  .recipe-intro {
    max-width: 850px;
    padding: 2rem 0 0;
  }
  h1 {
    font:
      500 clamp(2.4rem, 5vw, 4.4rem)/1.05 'Cormorant Garamond',
      Georgia,
      serif;
    letter-spacing: -0.025em;
    margin: 0.8rem 0 1.2rem;
    text-wrap: balance;
  }
  .recipe-description {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 660px;
  }
  .recipe-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    border-block: 1px solid var(--border-subtle);
    padding: 1.3rem 0;
    margin-top: 1.8rem;
  }
  dt {
    color: var(--text-secondary);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  dd {
    margin-top: 0.35rem;
    font-size: 1rem;
  }
  .timing-note {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 1rem;
  }
  .recipe-details {
    margin: 1rem 0;
    font-size: 0.85rem;
  }
  summary {
    cursor: pointer;
    padding: 0.6rem 0;
    color: var(--accent-gold);
  }
  .recipe-details dl {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    margin: 1rem 0;
  }
  .recipe-details p {
    color: var(--text-secondary);
    font-size: 0.8rem;
  }
</style>
