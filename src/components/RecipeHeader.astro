---
import DishArt from './DishArt.astro';
import { dishVisuals } from '../data/dish-visuals';
import type { CollectionEntry } from 'astro:content';
import { timeBand, formatMinutes } from '../lib/time-band.mjs';
interface Props {
  recipe: CollectionEntry<'recipes'>;
  baseUrl?: string;
  /** The chef's note, already rendered as paragraphs. */
  noteHtml?: string;
}
const { recipe, baseUrl = import.meta.env.BASE_URL, noteHtml = '' } = Astro.props;
const { data } = recipe;
const time = timeBand(data.totalTime);
// A cook-written time keeps its own words ("plus cooling"); only the color comes from the estimate.
const totalText = time.exact ? formatMinutes(time.minutes) : data.totalTime;
const splitTimes = [
  data.prepTime && `Prep ${data.prepTime}`,
  data.cookTime && `Cook ${data.cookTime}`,
]
  .filter(Boolean)
  .join(' · ');
// "6" and "6 portions" both read as Serves 6.
const servesMatch = String(data.servings || '').match(
  /^([\d\s–-]+?)(?:\s+(?:portions?|servings?))?$/
);
const serves = servesMatch ? servesMatch[1].trim() : '';
const dietaryLabels: Record<string, string> = {
  vegan: 'Vegan',
  vegetarian: 'Vegetarian',
  pescatarian: 'Pescatarian',
  'gluten-free': 'Gluten-free',
  'dairy-free': 'Dairy-free',
  'egg-free': 'Egg-free',
  'nut-free': 'Nut-free',
  'low-carb': 'Low-carb',
  keto: 'Keto',
};
const dietary = (data.dietary || []).map((tag) => dietaryLabels[tag]).filter(Boolean);
---

<div data-recipe-header class:list={{ 'has-art': !!dishVisuals[recipe.slug] }}>
  <img class="print-wordmark" src={`${baseUrl}brand/mise-wordmark.svg`} alt="mise." />
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={baseUrl}>Recipes</a><span aria-hidden="true">/</span><span
      >{data.cuisines?.[0] || 'The collection'}</span
    >
  </nav>
  <div class="recipe-intro">
    <h1>{data.title}</h1>
    <dl class="recipe-facts">
      <div class="fact fact-time" data-band={time.band}>
        <dt>Total</dt>
        <dd>{totalText || 'Not listed'}</dd>
        {splitTimes && <p class="fact-note">{splitTimes}</p>}
      </div>
      {
        data.servings && (
          <div class="fact">
            <dt>{serves ? 'Serves' : 'Makes'}</dt>
            <dd data-header-yield="">{serves || data.servings}</dd>
          </div>
        )
      }
      {
        data.difficulty && (
          <div class="fact">
            <dt>Level</dt>
            <dd class="capitalize">{data.difficulty}</dd>
          </div>
        )
      }
    </dl>
    {
      dietary.length > 0 && (
        <ul class="diet-tags" aria-label="Dietary">
          {dietary.map((label) => (
            <li>{label}</li>
          ))}
        </ul>
      )
    }
    {noteHtml && <div class="recipe-note" set:html={noteHtml} />}
  </div>
  {
    dishVisuals[recipe.slug] && (
      <div class="recipe-art">
        <DishArt slug={recipe.slug} eager caption />
      </div>
    )
  }
</div>
<style>
  .print-wordmark {
    display: none;
  }
  .has-art {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 0 2.5rem;
    align-items: start;
  }
  .has-art .breadcrumb {
    grid-column: 1/-1;
  }
  .recipe-art {
    padding-top: 2.2rem;
  }
  .has-art h1 {
    font-size: clamp(2.4rem, 4vw, 3.5rem);
  }
  @media (max-width: 760px) {
    .has-art {
      grid-template-columns: 1fr;
    }
    /* On a phone the dish comes first: the food is the colour on the page. */
    .has-art .breadcrumb {
      order: -2;
    }
    .recipe-art {
      order: -1;
      padding-top: 0.75rem;
      width: min(300px, 100%);
      justify-self: center;
    }
    .recipe-art :global(figcaption) {
      display: none;
    }
    .recipe-intro {
      padding-top: 0.5rem;
    }
  }
  @media print {
    .recipe-art {
      display: none;
    }
    .has-art {
      display: block;
    }
    .print-wordmark {
      display: block;
      width: 24mm;
      height: auto;
      margin-bottom: 3mm;
    }
  }
  .recipe-intro {
    max-width: 850px;
    padding: 2rem 0 0;
  }
  h1 {
    font:
      650 clamp(2.4rem, 5vw, 4.2rem)/1.05 'Fraunces',
      Georgia,
      serif;
    letter-spacing: -0.025em;
    margin: 0.4rem 0 1.2rem;
    text-wrap: balance;
  }
  .recipe-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.6rem;
    margin-top: 1.6rem;
    max-width: 620px;
  }
  .fact {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    min-width: 0;
  }
  /* The total time card carries the time band: the one warm accent in the header. */
  .fact-time {
    background: var(--time-quick);
    border-color: transparent;
  }
  .fact-time[data-band='hour'] {
    background: var(--time-hour);
  }
  .fact-time[data-band='long'] {
    background: var(--time-long);
  }
  .fact-time[data-band='none'] {
    background: var(--bg-surface);
    border: 1.5px dashed var(--border-emphasis);
  }
  .fact-time dt,
  .fact-time .fact-note {
    color: var(--on-time);
  }
  dt {
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
  }
  dd {
    margin-top: 0.3rem;
    font:
      600 1.25rem/1.2 'Fraunces',
      Georgia,
      serif;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    overflow-wrap: anywhere;
  }
  .fact-note {
    font-size: 0.75rem;
    margin-top: 0.35rem;
    line-height: 1.4;
  }
  .diet-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0;
  }
  .diet-tags li {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.2rem 0.7rem;
    border-radius: var(--pill);
    background: var(--wash);
    color: var(--text-primary);
  }
  .recipe-note {
    max-width: 660px;
    margin-top: 1.4rem;
  }
  .recipe-note :global(p) {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-primary);
    margin: 0 0 0.8rem;
  }
  .recipe-note :global(a) {
    color: var(--accent-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
