---
import DishArt from './DishArt.astro';
import { dishVisuals } from '../data/dish-visuals';
import type { CollectionEntry } from 'astro:content';
import { timeBand, formatMinutes } from '../lib/time-band.mjs';
interface Props {
  recipe: CollectionEntry<'recipes'>;
  baseUrl?: string;
}
const { recipe, baseUrl = import.meta.env.BASE_URL } = Astro.props;
const { data } = recipe;
const time = timeBand(data.totalTime);
// A cook-written time keeps its own words ("plus cooling"); only the colour comes from the estimate.
const totalText = time.exact ? formatMinutes(time.minutes) : data.totalTime;
const splitTimes = [
  data.prepTime && `Prep ${data.prepTime}`,
  data.cookTime && `Cook ${data.cookTime}`,
]
  .filter(Boolean)
  .join(' · ');
---

<div data-recipe-header class:list={{ 'has-art': !!dishVisuals[recipe.slug] }}>
  <img class="print-wordmark" src={`${baseUrl}brand/mise-wordmark.svg`} alt="mise." />
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={baseUrl}>Recipes</a><span aria-hidden="true">/</span><span
      >{data.cuisines?.[0] || 'The collection'}</span
    >
  </nav>
  <div class="recipe-intro">
    <p class="eyebrow">
      {data.learning ? 'Cook & understand' : 'From the collection'}
      <span aria-hidden="true"> / </span>
      {data.difficulty || 'All levels'}
    </p>
    <h1>{data.title}</h1>
    {data.description && <p class="recipe-description">{data.description}</p>}
    <dl class="recipe-facts">
      <div class="fact fact-time" data-band={time.band}>
        <dt>Total</dt>
        <dd>
          {totalText || 'Not listed'}
          {
            time.level > 0 && (
              <span class="time-meter" data-level={time.level} aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
            )
          }
        </dd>
        {splitTimes && <p class="fact-note">{splitTimes}</p>}
      </div>
      {
        data.servings && (
          <div class="fact">
            <dt>Serves / makes</dt>
            <dd data-header-yield="">{data.servings}</dd>
          </div>
        )
      }
      {
        data.difficulty && (
          <div class="fact">
            <dt>Level</dt>
            <dd class="capitalize">{data.difficulty}</dd>
          </div>
        )
      }
    </dl>
    {data.learning && <p class="timing-note">{data.learning.timing}</p>}
    <details class="recipe-details">
      <summary>Recipe details & dietary notes</summary>
      <dl>
        {
          [
            ['Cuisine', data.cuisines?.join(', ')],
            ['Methods', data.cookingMethods?.join(', ')],
            ['Dietary tags', data.dietary?.join(', ')],
            ['Equipment', data.equipment?.map((x) => x.replaceAll('-', ' ')).join(', ')],
            ['Make ahead', data.advancePrep?.map((x) => x.replaceAll('-', ' ')).join(', ')],
          ]
            .filter(([, value]) => value)
            .map(([label, value]) => (
              <div>
                <>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </>
              </div>
            ))
        }
      </dl>
      {
        data.dietary?.length && (
          <p>
            Tags describe the listed ingredients and noted options. Check packaged ingredients and
            substitutions for your dietary needs.
          </p>
        )
      }
    </details>
  </div>
  {
    dishVisuals[recipe.slug] && (
      <div class="recipe-art">
        <DishArt slug={recipe.slug} eager caption />
      </div>
    )
  }
</div>
<style>
  .print-wordmark {
    display: none;
  }
  .has-art {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 0 2.5rem;
    align-items: start;
  }
  .has-art .breadcrumb {
    grid-column: 1/-1;
  }
  .recipe-art {
    padding-top: 2.2rem;
  }
  .has-art h1 {
    font-size: clamp(2.4rem, 4vw, 3.5rem);
  }
  @media (max-width: 760px) {
    .has-art {
      grid-template-columns: 1fr;
    }
    /* On a phone the dish comes first: the food is the colour on the page. */
    .has-art .breadcrumb {
      order: -2;
    }
    .recipe-art {
      order: -1;
      padding-top: 0.75rem;
      width: min(300px, 100%);
      justify-self: center;
    }
    .recipe-art :global(figcaption) {
      display: none;
    }
    .recipe-intro {
      padding-top: 0.5rem;
    }
  }
  @media print {
    .recipe-art {
      display: none;
    }
    .has-art {
      display: block;
    }
    .print-wordmark {
      display: block;
      width: 24mm;
      height: auto;
      margin-bottom: 3mm;
    }
  }
  .recipe-intro {
    max-width: 850px;
    padding: 2rem 0 0;
  }
  h1 {
    font:
      650 clamp(2.4rem, 5vw, 4.2rem)/1.05 'Fraunces',
      Georgia,
      serif;
    letter-spacing: -0.025em;
    margin: 0.8rem 0 1.2rem;
    text-wrap: balance;
  }
  .recipe-description {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 660px;
  }
  .recipe-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.6rem;
    margin-top: 1.6rem;
    max-width: 620px;
  }
  .fact {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    min-width: 0;
  }
  /* The total time card carries the time band: the one warm accent in the header. */
  .fact-time {
    background: var(--time-quick);
    border-color: transparent;
  }
  .fact-time[data-band='hour'] {
    background: var(--time-hour);
  }
  .fact-time[data-band='long'] {
    background: var(--time-long);
  }
  .fact-time[data-band='none'] {
    background: var(--bg-surface);
    border: 1.5px dashed var(--border-emphasis);
  }
  .fact-time dt,
  .fact-time .fact-note {
    color: var(--on-time);
  }
  dt {
    color: var(--text-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  dd {
    margin-top: 0.3rem;
    font:
      600 1.25rem/1.2 'Fraunces',
      Georgia,
      serif;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    overflow-wrap: anywhere;
  }
  .fact-note {
    font-size: 0.75rem;
    margin-top: 0.35rem;
    line-height: 1.4;
  }
  .timing-note {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 1rem;
  }
  .recipe-details {
    margin: 1rem 0;
    font-size: 0.85rem;
  }
  summary {
    cursor: pointer;
    padding: 0.6rem 0;
    color: var(--accent-gold);
  }
  .recipe-details summary {
    font-weight: 600;
  }
  .recipe-details dl {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    margin: 1rem 0;
  }
  .recipe-details p {
    color: var(--text-secondary);
    font-size: 0.8rem;
  }
</style>
