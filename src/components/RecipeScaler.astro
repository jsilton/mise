---
import { formatYield } from '../lib/quantities.mjs';
interface Props {
  servings: string;
  formula?: any;
  scaling?: { mode: 'fixed'; reason: string };
}
const { servings, scaling, formula } = Astro.props;
const fixed = scaling?.mode === 'fixed';
// Page rule: no semicolons. A reason written with one reads as two sentences.
const reason = scaling?.reason
  ?.replace(/\s*;\s*(\S)/g, (_match, next: string) => `. ${next.toUpperCase()}`)
  .replace(/\s*;\s*$/, '');
---

<div
  id="recipe-scaler"
  data-original-yield={servings}
  data-formula={formula ? JSON.stringify(formula) : undefined}
  data-current-scale="1"
  data-fixed-batch={fixed ? '' : undefined}
>
  <div class="scale-row">
    <span id="scaled-yield">{formatYield(servings)}</span>{
      !fixed && (
        <div class="scale-options" role="group" aria-label="Scale ingredient quantities">
          {[0.25, 0.5, 1, 2, 3].map((factor) => (
            <button type="button" data-scale={factor} aria-pressed={factor === 1}>
              {factor === 0.25 ? '¼' : factor === 0.5 ? '½' : factor}×
            </button>
          ))}
        </div>
      )
    }
  </div>
  {fixed && <p id="scaling-note">{reason}</p>}
  {!fixed && <p id="step-amount-note" hidden />}
</div>
<script>
  import {
    formulaEntries,
    formatFormulaIngredient,
    formulaYield,
    formulaShoppingList,
    formulaStepAmounts,
  } from '../lib/recipe-formula.mjs';
  import { scaleIngredientParts, formatYield } from '../lib/quantities.mjs';
  import { splitLeadingQuantity } from '../lib/ingredient-quantity.mjs';
  const scaler = document.getElementById('recipe-scaler');
  const formula = scaler?.dataset.formula ? JSON.parse(scaler.dataset.formula) : null;
  const entries = formula ? formulaEntries(formula) : [];
  // Each ingredient's original markup, without the bold amount, so scaling always starts
  // from the recipe as written and the amount is bolded again afterwards.
  const originalHtml = new WeakMap<HTMLElement, string>();
  function plainHtml(span: HTMLElement) {
    const copy = span.cloneNode(true) as HTMLElement;
    copy.querySelectorAll('b.qty').forEach((b) => b.replaceWith(b.textContent || ''));
    copy.normalize();
    return copy.innerHTML;
  }
  function boldAmount(span: HTMLElement) {
    const first = span.firstChild;
    if (!first || first.nodeType !== Node.TEXT_NODE) return;
    const [quantity, rest] = splitLeadingQuantity(first.textContent || '');
    if (!quantity) return;
    const b = document.createElement('b');
    b.className = 'qty';
    b.textContent = quantity;
    first.textContent = rest;
    span.insertBefore(b, first);
  }
  // ---------- Amounts inside the steps ----------
  // A structured recipe prints the amount when a step uses part of an ingredient ("2 tbsp of
  // the oil"). Those amounts scale with the batch. Any other measured amount in the method was
  // typed by hand, so it stays as written and a short note under the scaler says so.
  const stepNote = document.getElementById('step-amount-note');
  const method = document.querySelector<HTMLElement>('.recipe-method');
  function methodSteps(): HTMLElement[] {
    let list = document.getElementById('directions')?.nextElementSibling;
    while (list && list.tagName !== 'OL' && !/^H[1-6]$/.test(list.tagName))
      list = list.nextElementSibling;
    return list?.tagName === 'OL' ? [...list.querySelectorAll<HTMLElement>(':scope > li')] : [];
  }
  const measured =
    /(?:(?:\d|[¼½¾⅓⅔⅛⅜⅝⅞])\s*|\b(?:half|quarter|third|one|two|three|four|five|six)\s+(?:(?:of\s+)?an?\s+)?)(?:cups?|tbsp|tsp|tablespoons?|teaspoons?|oz|ounces?|lbs?|pounds?|g|grams?|kg|ml|l|liters?|sticks?|quarts?|pints?)\b/i;
  const plain = (text: string) => text.replace(/[‘’]/g, "'");
  const stepText = new WeakMap<Text, string>();
  function textNodes(root: HTMLElement) {
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const nodes: Text[] = [];
    while (walker.nextNode()) nodes.push(walker.currentNode as Text);
    return nodes;
  }
  function scaleSteps(factor: number) {
    const steps = methodSteps();
    const original = formula ? formulaStepAmounts(formula, 1) : [];
    const scaled = formula ? formulaStepAmounts(formula, factor) : [];
    let inSteps = false;
    steps.forEach((step, index) => {
      const nodes = textNodes(step);
      nodes.forEach((node) => {
        if (!stepText.has(node)) stepText.set(node, node.textContent || '');
        node.textContent = stepText.get(node)!;
      });
      // What is left of the step once the amounts that scale are taken out.
      let rest = nodes.map((node) => stepText.get(node)).join('');
      const cursor = new Map<Text, number>();
      (original[index] || []).forEach((phrase, order) => {
        const node = nodes.find(
          (n) => plain(n.textContent || '').indexOf(phrase, cursor.get(n) || 0) >= 0
        );
        if (!node) return;
        const text = node.textContent || '';
        const at = plain(text).indexOf(phrase, cursor.get(node) || 0);
        const next = scaled[index]?.[order] ?? phrase;
        node.textContent = text.slice(0, at) + next + text.slice(at + phrase.length);
        cursor.set(node, at + next.length);
        rest = plain(rest).replace(phrase, '');
      });
      if (measured.test(rest)) inSteps = true;
    });
    if (!stepNote) return;
    const inNotes =
      !inSteps &&
      !!method &&
      textNodes(method).some(
        (node) =>
          !steps.some((step) => step.contains(node)) && measured.test(node.textContent || '')
      );
    stepNote.hidden = factor === 1 || !(inSteps || inNotes);
    stepNote.textContent = inSteps
      ? 'Step amounts are for the original batch.'
      : 'Amounts in the notes are for the original batch.';
  }
  scaler?.querySelectorAll<HTMLButtonElement>('[data-scale]').forEach((button) => {
    button.addEventListener('click', () => {
      const factor = Number(button.dataset.scale);
      scaler.dataset.currentScale = String(factor);
      scaler
        .querySelectorAll('[data-scale]')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      document.querySelectorAll<HTMLElement>('[data-ingredient-text]').forEach((span) => {
        if (!originalHtml.has(span)) originalHtml.set(span, plainHtml(span));
        span.innerHTML = originalHtml.get(span)!;
        const walker = document.createTreeWalker(span, NodeFilter.SHOW_TEXT);
        const nodes: Text[] = [];
        while (walker.nextNode()) nodes.push(walker.currentNode as Text);
        const parts = nodes.map((node) => node.textContent || '');
        const entry = entries[Number(span.dataset.formulaIndex)];
        const scaled = entry
          ? [formatFormulaIngredient(entry, factor)]
          : scaleIngredientParts(parts, factor);
        nodes.forEach((node, index) => {
          node.textContent = scaled[index] ?? '';
        });
        boldAmount(span);
      });
      const yieldLabel = document.getElementById('scaled-yield');
      const scaledYield = formula
        ? formulaYield(formula, factor)
        : formatYield(scaler.dataset.originalYield || '', factor);
      if (formula) {
        const shopping = formulaShoppingList(formula, factor);
        document.querySelectorAll<HTMLElement>('[data-formula-shopping]').forEach((item, index) => {
          item.textContent = shopping[index];
          boldAmount(item);
        });
      }
      scaleSteps(factor);
      if (yieldLabel) yieldLabel.textContent = scaledYield;
      const headerYield = document.querySelector('[data-header-yield]');
      if (headerYield)
        headerYield.textContent = scaledYield
          .replace(/^Serves /, '')
          .replace(/^([\d\s–-]+?)\s+(?:portions?|servings?)$/, '$1');
      document.dispatchEvent(new CustomEvent('mise:scaled', { detail: { factor } }));
    });
  });
</script>
<style>
  #recipe-scaler {
    padding: 1rem 0;
    margin-bottom: 1.3rem;
  }
  .scale-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }
  .scale-options {
    display: flex;
    gap: 0.2rem;
  }
  button {
    min-width: 40px;
    min-height: 44px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--pill);
    font-weight: 700;
  }
  button[aria-pressed='true'] {
    background: var(--accent-strong);
    color: var(--bg-deep);
    border-color: var(--accent-gold);
  }
  #scaling-note,
  #step-amount-note {
    font-size: 0.74rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-top: 0.7rem;
  }
</style>
