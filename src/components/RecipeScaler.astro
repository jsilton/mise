---
import { formulaShoppingList } from '../lib/recipe-formula.mjs';
import { formatYield } from '../lib/quantities.mjs';
interface Props {
  servings: string;
  formula?: any;
  scaling?: { mode: 'fixed'; reason: string };
}
const { servings, scaling, formula } = Astro.props;
const fixed = scaling?.mode === 'fixed';
---

<div
  id="recipe-scaler"
  data-original-yield={servings}
  data-formula={formula ? JSON.stringify(formula) : undefined}
  data-current-scale="1"
  data-fixed-batch={fixed ? '' : undefined}
>
  <div class="scale-row">
    <span id="scaled-yield">{formatYield(servings)}</span>{
      !fixed && (
        <div class="scale-options" role="group" aria-label="Scale ingredient quantities">
          {[0.25, 0.5, 1, 2, 3].map((factor) => (
            <button type="button" data-scale={factor} aria-pressed={factor === 1}>
              {factor === 0.25 ? '¼' : factor === 0.5 ? '½' : factor}×
            </button>
          ))}
        </div>
      )
    }
  </div>
  <p id="scaling-note" role="status" aria-live="polite">
    {fixed ? scaling?.reason : 'Original quantities. Choose a batch size.'}
  </p>
  {
    formula && (
      <details class="shopping-list">
        <>
          <summary>Combined shopping list</summary>
          <ul>
            {formulaShoppingList(formula).map((line) => (
              <li data-formula-shopping>{line}</li>
            ))}
          </ul>
        </>
      </details>
    )
  }
</div>
<script>
  import {
    formulaEntries,
    formatFormulaIngredient,
    formulaYield,
    formulaShoppingList,
  } from '../lib/recipe-formula.mjs';
  import { scaleIngredientParts, formatYield } from '../lib/quantities.mjs';
  import { splitLeadingQuantity } from '../lib/ingredient-quantity.mjs';
  const scaler = document.getElementById('recipe-scaler');
  const formula = scaler?.dataset.formula ? JSON.parse(scaler.dataset.formula) : null;
  const entries = formula ? formulaEntries(formula) : [];
  // Each ingredient's original markup, without the bold amount, so scaling always starts
  // from the recipe as written and the amount is bolded again afterwards.
  const originalHtml = new WeakMap<HTMLElement, string>();
  function plainHtml(span: HTMLElement) {
    const copy = span.cloneNode(true) as HTMLElement;
    copy.querySelectorAll('b.qty').forEach((b) => b.replaceWith(b.textContent || ''));
    copy.normalize();
    return copy.innerHTML;
  }
  function boldAmount(span: HTMLElement) {
    const first = span.firstChild;
    if (!first || first.nodeType !== Node.TEXT_NODE) return;
    const [quantity, rest] = splitLeadingQuantity(first.textContent || '');
    if (!quantity) return;
    const b = document.createElement('b');
    b.className = 'qty';
    b.textContent = quantity;
    first.textContent = rest;
    span.insertBefore(b, first);
  }
  scaler?.querySelectorAll<HTMLButtonElement>('[data-scale]').forEach((button) => {
    button.addEventListener('click', () => {
      const factor = Number(button.dataset.scale);
      scaler.dataset.currentScale = String(factor);
      scaler
        .querySelectorAll('[data-scale]')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      document.querySelectorAll<HTMLElement>('[data-ingredient-text]').forEach((span) => {
        if (!originalHtml.has(span)) originalHtml.set(span, plainHtml(span));
        span.innerHTML = originalHtml.get(span)!;
        const walker = document.createTreeWalker(span, NodeFilter.SHOW_TEXT);
        const nodes: Text[] = [];
        while (walker.nextNode()) nodes.push(walker.currentNode as Text);
        const parts = nodes.map((node) => node.textContent || '');
        const entry = entries[Number(span.dataset.formulaIndex)];
        const scaled = entry
          ? [formatFormulaIngredient(entry, factor)]
          : scaleIngredientParts(parts, factor);
        nodes.forEach((node, index) => {
          node.textContent = scaled[index] ?? '';
        });
        boldAmount(span);
      });
      const yieldLabel = document.getElementById('scaled-yield');
      const scaledYield = formula
        ? formulaYield(formula, factor)
        : formatYield(scaler.dataset.originalYield || '', factor);
      if (formula) {
        const shopping = formulaShoppingList(formula, factor);
        document.querySelectorAll('[data-formula-shopping]').forEach((item, index) => {
          item.textContent = shopping[index];
        });
      }
      if (yieldLabel) yieldLabel.textContent = scaledYield;
      const headerYield = document.querySelector('[data-header-yield]');
      if (headerYield) headerYield.textContent = scaledYield.replace(/^Serves /, '');
      const note = document.getElementById('scaling-note');
      if (note)
        note.textContent =
          factor === 1
            ? 'Original quantities. Choose a batch size.'
            : `Ingredients at ${factor}×. Method quantities refer to the original batch. Use the scaled list; pan sizes, heat, and cooking times do not multiply.`;
      document.dispatchEvent(new CustomEvent('mise:scaled', { detail: { factor } }));
    });
  });
</script>
<style>
  #recipe-scaler {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.3rem;
  }
  .scale-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }
  .scale-options {
    display: flex;
    gap: 0.2rem;
  }
  button {
    min-width: 40px;
    min-height: 44px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--pill);
    font-weight: 700;
  }
  button[aria-pressed='true'] {
    background: var(--accent-strong);
    color: var(--bg-deep);
    border-color: var(--accent-gold);
  }
  #scaling-note {
    font-size: 0.74rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-top: 0.7rem;
  }
</style>
