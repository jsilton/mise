---
import { getEntry } from 'astro:content';
interface Props {
  targetSlug: string;
}
const { targetSlug } = Astro.props;
const recipe = await getEntry('recipes', targetSlug);
if (!recipe) throw new Error(`Recipe redirect target does not exist: ${targetSlug}`);
const target = `${import.meta.env.BASE_URL}recipes/${targetSlug}/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex" />
    <title>{recipe.data.title} | Mise</title>
  </head>
  <body>
    <p>This recipe is now part of <a href={target}>{recipe.data.title}</a>.</p>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target + window.location.search + window.location.hash);
    </script>
  </body>
</html>
