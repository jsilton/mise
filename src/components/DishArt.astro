---
import { dishVisuals } from '../data/dish-visuals';
interface Props {
  slug: string;
  eager?: boolean;
  caption?: boolean;
}
const { slug, eager = false } = Astro.props;
const visual = dishVisuals[slug];
---

{
  visual && (
    <figure class="dish-art">
      <img
        src={`${import.meta.env.BASE_URL}images/dishes/${visual.file || slug + '.svg'}`}
        alt={visual.alt}
        width="960"
        height="640"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    </figure>
  )
}
<style>
  .dish-art {
    margin: 0;
    width: 100%;
  }
  img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
