---
// RecipeCard.astro - Reusable recipe card component for grid display
// Encapsulates all card styling, tags, and data attributes

import DishArt from './DishArt.astro';
import TagBadge from './TagBadge.astro';
import { getTechniquesForRecipe } from '../data/techniques';

interface Recipe {
  slug: string;
  data: {
    title: string;
    difficulty?: string;
    role?: string;
    vibe?: string;
    cuisines?: string[];
    dietary?: string[];
    cookingMethods?: string[];
    occasions?: string[];
    flavorProfile?: string[];
    prepTime?: string;
    cookTime?: string;
    totalTime?: string;
    description?: string;
    learning?: { focus: string; techniques: string[] };
    ingredients?: string[];
  };
}

interface Props {
  recipe: Recipe;
  baseUrl?: string;
}

const { recipe, baseUrl = import.meta.env.BASE_URL } = Astro.props;

const lessons = getTechniquesForRecipe(recipe);

// Extract primary dietary tag (prioritize vegetarian/vegan)
const primaryDietaryTag =
  recipe.data.dietary?.find((d) => d === 'vegetarian' || d === 'vegan') || recipe.data.dietary?.[0];
---

<a
  href={`${baseUrl}recipes/${recipe.slug}`}
  class="recipe-card group rounded-sm transition-all duration-200 overflow-hidden flex flex-col h-full min-h-[13rem]"
  style="background: var(--bg-surface); border: 1px solid var(--border-subtle);"
  data-difficulty={recipe.data.difficulty}
  data-role={recipe.data.role}
  data-vibe={recipe.data.vibe}
  data-cuisines={recipe.data.cuisines?.join(',')}
  data-dietary={recipe.data.dietary?.join(',')}
  data-cooking-methods={recipe.data.cookingMethods?.join(',')}
  data-occasions={recipe.data.occasions?.join(',')}
  data-flavor-profile={recipe.data.flavorProfile?.join(',')}
  data-prep-time={recipe.data.prepTime}
>
  <DishArt slug={recipe.slug} />
  <div class="p-4 flex flex-col h-full">
    <h2
      class="text-xl font-display font-semibold mb-3 leading-snug tracking-tight transition-colors"
      style="color: var(--text-primary);"
    >
      {recipe.data.title}
    </h2>

    <!-- Key Tags -->
    <div class="flex flex-wrap gap-2 mb-3">
      {
        recipe.data.cuisines?.[0] && (
          <TagBadge tag={recipe.data.cuisines[0]} category="cuisine" size="sm" />
        )
      }
      {
        recipe.data.difficulty && (
          <TagBadge tag={recipe.data.difficulty} category="difficulty" size="sm" />
        )
      }
      {primaryDietaryTag && <TagBadge tag={primaryDietaryTag} category="dietary" size="sm" />}
    </div>

    {recipe.data.description && <p class="card-description">{recipe.data.description}</p>}
    {
      (recipe.data.learning || lessons.length > 0) && (
        <p class="card-lesson">
          <span>{recipe.data.learning ? 'Learn' : 'Technique'}</span>{' '}
          {recipe.data.learning?.focus || lessons[0].title}
        </p>
      )
    }

    <!-- Time metadata -->
    <div
      class="mt-auto pt-3 flex items-center justify-between text-xs font-medium"
      style="border-top: 1px solid var(--border-subtle); color: var(--text-tertiary);"
    >
      <div class="flex items-center gap-2">
        {
          recipe.data.totalTime ? (
            <span>{recipe.data.totalTime} total</span>
          ) : (
            recipe.data.prepTime && <span>{recipe.data.prepTime} prep</span>
          )
        }
        {
          !recipe.data.totalTime && recipe.data.cookTime && (
            <span class="flex items-center gap-1">
              <span style="color: var(--border-emphasis);">·</span>
              {recipe.data.cookTime} cook
            </span>
          )
        }
      </div>
    </div>
  </div>

  <!-- Hidden search data for filtering -->
  <div class="hidden search-data">
    {recipe.data.title.toLowerCase()}
    {recipe.data.ingredients?.join(' ').toLowerCase()}
  </div>
</a>

<style>
  .card-description {
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }
  .card-lesson {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0.2rem 0 1.2rem;
  }
  .card-lesson span {
    color: var(--accent-gold);
    margin-right: 0.35rem;
  }
  .recipe-card:hover {
    border-color: var(--accent-gold-muted) !important;
  }
  .recipe-card:hover h2 {
    color: var(--accent-gold) !important;
  }
</style>
