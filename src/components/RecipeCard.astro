---
// RecipeCard.astro - Reusable recipe card component for grid display
// Encapsulates all card styling, tags, and data attributes

import DishArt from './DishArt.astro';
import TagBadge from './TagBadge.astro';
import { getTechniquesForRecipe } from '../data/techniques';
import { timeBand } from '../lib/time-band.mjs';
import { quickPicksFor } from '../lib/quick-picks.mjs';

interface Recipe {
  slug: string;
  data: {
    title: string;
    difficulty?: string;
    role?: string;
    vibe?: string;
    cuisines?: string[];
    dietary?: string[];
    cookingMethods?: string[];
    occasions?: string[];
    flavorProfile?: string[];
    prepTime?: string;
    cookTime?: string;
    totalTime?: string;
    description?: string;
    learning?: { focus: string; techniques: string[] };
    ingredients?: string[];
  };
}

interface Props {
  recipe: Recipe;
  baseUrl?: string;
}

const { recipe, baseUrl = import.meta.env.BASE_URL } = Astro.props;

const lessons = getTechniquesForRecipe(recipe);

// Extract primary dietary tag (prioritize vegetarian/vegan)
const time = timeBand(recipe.data.totalTime);
const timeText = time.short || recipe.data.totalTime;

const primaryDietaryTag =
  recipe.data.dietary?.find((d) => d === 'vegetarian' || d === 'vegan') || recipe.data.dietary?.[0];
---

<a
  href={`${baseUrl}recipes/${recipe.slug}`}
  class="recipe-card group transition-all duration-200 overflow-hidden flex flex-col h-full min-h-[13rem]"
  style="background: var(--bg-surface); border: 1px solid var(--border-subtle);"
  data-difficulty={recipe.data.difficulty}
  data-role={recipe.data.role}
  data-vibe={recipe.data.vibe}
  data-cuisines={recipe.data.cuisines?.join(',')}
  data-dietary={recipe.data.dietary?.join(',')}
  data-cooking-methods={recipe.data.cookingMethods?.join(',')}
  data-occasions={recipe.data.occasions?.join(',')}
  data-flavor-profile={recipe.data.flavorProfile?.join(',')}
  data-prep-time={recipe.data.prepTime}
  data-minutes={time.minutes || undefined}
  data-picks={quickPicksFor(recipe.data).join(',')}
  data-title={recipe.data.title}
>
  <DishArt slug={recipe.slug} />
  <div class="card-body p-4 flex flex-col h-full">
    <h2
      class="card-title text-xl font-display font-semibold mb-3 leading-snug tracking-tight transition-colors"
      style="color: var(--text-primary);"
    >
      {recipe.data.title}
    </h2>

    <!-- Key Tags -->
    <div class="card-tags flex flex-wrap gap-2 mb-3">
      {
        recipe.data.cuisines?.[0] && (
          <TagBadge tag={recipe.data.cuisines[0]} category="cuisine" size="sm" />
        )
      }
      {
        recipe.data.difficulty && (
          <TagBadge tag={recipe.data.difficulty} category="difficulty" size="sm" />
        )
      }
      {primaryDietaryTag && <TagBadge tag={primaryDietaryTag} category="dietary" size="sm" />}
    </div>

    {recipe.data.description && <p class="card-description">{recipe.data.description}</p>}
    {
      (recipe.data.learning || lessons.length > 0) && (
        <p class="card-lesson">
          <span>{recipe.data.learning ? 'Learn' : 'Technique'}</span>{' '}
          {recipe.data.learning?.focus || lessons[0].title}
        </p>
      )
    }

    <!-- Time: the one warm accent on a card. Minutes are always printed beside the colour. -->
    <div class="card-time mt-auto pt-3">
      {
        timeText ? (
          <span class="time-chip" data-band={time.band} title={time.label}>
            {timeText}
          </span>
        ) : (
          <span class="time-chip" data-band="none">
            {recipe.data.prepTime
              ? `${recipe.data.prepTime} prep`
              : recipe.data.cookTime
                ? `${recipe.data.cookTime} cook`
                : 'Time not listed'}
          </span>
        )
      }
    </div>
  </div>
</a>

<style>
  .card-description {
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }
  .card-lesson {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0.2rem 0 1.2rem;
  }
  .card-lesson span {
    color: var(--accent-gold);
    margin-right: 0.35rem;
  }
  .recipe-card {
    border-radius: var(--radius);
  }
  .recipe-card :global(.dish-art) {
    background: var(--bg-elevated);
  }
  .recipe-card:hover {
    border-color: var(--accent-gold-muted) !important;
    box-shadow: 0 6px 18px rgba(31, 52, 64, 0.08);
  }
  .recipe-card:hover h2 {
    color: var(--accent-gold) !important;
  }
  /* On a phone a card is a row: a small painting, the name, the tags and the time.
     Twelve of them fit in a few thumb-scrolls instead of twelve screens. */
  @media (max-width: 640px) {
    .recipe-card {
      flex-direction: row;
      min-height: 0;
    }
    .recipe-card :global(.dish-art) {
      flex: none;
      width: 104px;
      display: flex;
      align-items: center;
    }
    .card-body {
      padding: 0.85rem 1rem;
      min-width: 0;
    }
    .card-title {
      font-size: 1.12rem;
      line-height: 1.25;
      margin-bottom: 0.5rem;
    }
    .card-description,
    .card-lesson {
      display: none;
    }
    .card-tags {
      flex-wrap: nowrap;
      overflow: hidden;
      margin-bottom: 0.4rem;
    }
    .card-time {
      padding-top: 0.2rem;
    }
  }
</style>
