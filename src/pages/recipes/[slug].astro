---
import Layout from '../../layouts/Layout.astro';
import RecipeHeader from '../../components/RecipeHeader.astro';
import {
  parseRecipeContent,
  isIngredientDivider,
  recipeDescription,
} from '../../lib/recipe-content.mjs';
import { buildRecipeSchema } from '../../lib/recipe-schema.mjs';
import RecipeLearning from '../../components/RecipeLearning.astro';
import RecipeScaler from '../../components/RecipeScaler.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await recipe.render();

const BASE = import.meta.env.BASE_URL;
const learning = recipe.data.learning;
const allRecipes = await getCollection('recipes');
const recipeTitles = new Map(allRecipes.map((r) => [r.slug, r.data.title]));
const canonicalUrl = new URL(`${BASE}recipes/${recipe.slug}/`, Astro.site).href;

const isDivider = isIngredientDivider;
const parsedContent = parseRecipeContent(recipe.body || '');
const description = recipeDescription(recipe.data, parsedContent);
const schema = buildRecipeSchema(recipe.data, recipe.body || '', canonicalUrl, parsedContent);

function getDividerLabel(str: string): string {
  const match = str.match(/^-{3}\s+(.+?)\s+-{3}$/);
  return match ? match[1] : str;
}

function parseIngredientHtml(str: string): string {
  let html = str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
  html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, text, url) => {
    let href = url;
    if (!/^(?:https?:\/\/|\/(?!\/))/.test(href)) return text;
    if (href.startsWith('/recipes/')) {
      href = `${BASE}recipes/${href.slice('/recipes/'.length)}`;
    }
    return `<a href="${href}" style="color: var(--accent-link);" class="hover:underline font-medium">${text}</a>`;
  });
  return html;
}
---

<Layout
  title={`${recipe.data.title} | Mise`}
  description={description}
  jsonLd={JSON.stringify(schema).replace(/</g, '\\u003c')}
>
  <RecipeHeader {recipe} />
  <RecipeLearning {recipe} />
  <nav class="recipe-toolbar" aria-label="Recipe navigation">
    <div class="jump-links">
      <a href="#ingredients">Ingredients</a><a href="#directions">Method</a>{
        learning && <a href="#troubleshooting">Troubleshooting</a>
      }
    </div>
    <div class="recipe-actions">
      <button id="print-recipe" hidden>Print</button><button
        id="cook-mode-toggle"
        hidden
        aria-pressed="false">Cook mode</button
      >
    </div>
  </nav>
  <article class="recipe-body" data-recipe-slug={recipe.slug} data-url={canonicalUrl}>
    <aside class="ingredients-panel" aria-labelledby="ingredients">
      <h2 id="ingredients">Ingredients</h2>
      {
        recipe.data.servings && (
          <RecipeScaler
            servings={recipe.data.servings}
            scaling={recipe.data.scaling}
            formula={recipe.data.formula}
          />
        )
      }
      <ul class="ingredient-list">
        {
          (recipe.data.ingredients || []).map((ingredient, i) =>
            isDivider(ingredient) ? (
              <li class="ingredient-divider">{getDividerLabel(ingredient)}</li>
            ) : (
              <li class="ingredient-row">
                <input
                  id={`ingredient-${i}`}
                  type="checkbox"
                  data-ingredient-check={i}
                  aria-labelledby={`ingredient-label-${i}`}
                />
                <label
                  for={`ingredient-${i}`}
                  id={`ingredient-label-${i}`}
                  data-formula-index={recipe.data.formula ? i : undefined}
                  data-ingredient-text
                  set:html={parseIngredientHtml(ingredient)}
                />
              </li>
            )
          )
        }
      </ul>
      {
        learning && (
          <section class="before-cooking">
            <>
              <h3>Before you start</h3>
              <ul>
                {learning.before.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </>
          </section>
        )
      }
      <div class="cook-progress" hidden>
        <p id="cook-progress" role="status" aria-live="polite"></p><button id="reset-progress"
          >Reset checkmarks</button
        ><p id="wake-status">Keep your recipe close as you cook.</p>
      </div>
    </aside>
    <div class="recipe-main">
      <div class="recipe-method prose-refined"><Content /></div>
      {
        learning && (
          <>
            <section id="checkpoints" class="prose-refined checkpoint-section">
              <h2>What to watch for</h2>
              <p class="recipe-outcome">{learning.outcome}</p>
              {learning.checkpoints.map((checkpoint) => (
                <div class="checkpoint" data-checkpoint-step={checkpoint.step}>
                  <p class="eyebrow">Step {checkpoint.step} · Look for</p>
                  <p>{checkpoint.cue}</p>
                  <details>
                    <summary>Why this matters</summary>
                    <p>{checkpoint.why}</p>
                  </details>
                </div>
              ))}
            </section>
            <section id="troubleshooting" class="prose-refined troubleshooting">
              <h2>Something not quite right?</h2>
              {learning.troubleshooting.map((item) => (
                <details>
                  <summary>{item.problem}</summary>
                  <p>
                    <strong>Likely cause:</strong> {item.cause}
                  </p>
                  <p>
                    <strong>What to do:</strong> {item.fix}
                  </p>
                </details>
              ))}
            </section>
            {learning.substitutions?.length > 0 && (
              <section class="prose-refined">
                <h2>Substitutions & tradeoffs</h2>
                {learning.substitutions.map((item) => (
                  <div class="substitution">
                    <h3>
                      {item.ingredient} → {item.alternative}
                    </h3>
                    <p>{item.effect}</p>
                  </div>
                ))}
              </section>
            )}
            <section class="prose-refined">
              <>
                <h2>Make ahead & store</h2>
                <p>{learning.storage}</p>
              </>
            </section>
          </>
        )
      }
      {
        recipe.data.pairsWith?.length > 0 && (
          <section class="prose-refined pairings">
            <>
              <h2>Build the meal</h2>
              <ul>
                {recipe.data.pairsWith
                  .filter((slug) => recipeTitles.has(slug))
                  .map((slug) => (
                    <li>
                      <a href={`${BASE}recipes/${slug}`}>{recipeTitles.get(slug)}</a>
                    </li>
                  ))}
              </ul>
            </>
          </section>
        )
      }
      {
        recipe.data.source && (
          <p class="attribution">
            Recipe source:{' '}
            {recipe.data.sourceUrl ? (
              <a href={recipe.data.sourceUrl}>{recipe.data.source}</a>
            ) : (
              recipe.data.source
            )}
          </p>
        )
      }
    </div>
  </article>
</Layout>
<script src="../../lib/recipe-page.ts"></script>
<style is:global>
  .recipe-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    margin: 1.5rem 0 2rem;
    border-block: 1px solid var(--border-subtle);
    position: sticky;
    top: 64px;
    z-index: 15;
    background: var(--bg-deep);
  }
  .jump-links,
  .recipe-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .jump-links a {
    font-size: 0.8rem;
    padding: 0.6rem 0.4rem;
    color: var(--text-secondary);
  }
  .recipe-actions button {
    min-height: 44px;
    padding: 0.6rem 1rem;
    font-size: 0.8rem;
    border: 1px solid var(--border-emphasis);
    border-radius: 4px;
  }
  #cook-mode-toggle {
    background: var(--accent-gold);
    color: var(--bg-deep);
    font-weight: 600;
  }
  .recipe-body {
    display: grid;
    grid-template-columns: minmax(230px, 0.8fr) minmax(0, 1.6fr);
    gap: 3.5rem;
  }
  .ingredients-panel {
    align-self: start;
    padding: 1.4rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
  }
  .ingredients-panel h2 {
    font:
      500 2rem/1.2 'Cormorant Garamond',
      Georgia,
      serif;
  }
  .ingredient-list {
    list-style: none;
    padding: 0;
  }
  .ingredient-row {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.9rem;
    line-height: 1.65;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .ingredient-row input {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-top: 0.3rem;
    accent-color: var(--accent-gold);
    cursor: pointer;
  }
  .ingredient-row:has(input:checked) [data-ingredient-text] {
    text-decoration: line-through;
    color: var(--text-secondary);
  }
  .ingredient-divider {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    margin-top: 1.5rem;
  }
  .before-cooking {
    margin-top: 2rem;
  }
  .before-cooking h3 {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .before-cooking li {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-top: 0.8rem;
  }
  .recipe-main {
    min-width: 0;
  }
  .recipe-method ol > li {
    padding-top: 0.5rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .recipe-method ol > li::before {
    top: 0.5rem;
  }
  .checkpoint {
    border-left: 2px solid var(--accent-gold-muted);
    background: var(--bg-surface);
    padding: 1rem 1.1rem;
    margin: 1.3rem 0;
  }
  .checkpoint p {
    margin-bottom: 0.6rem;
  }
  .checkpoint summary {
    font-size: 0.82rem;
    color: var(--accent-gold);
    cursor: pointer;
  }
  .checkpoint details p {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
  }
  .troubleshooting {
    margin-top: 3rem;
  }
  .troubleshooting h2 {
    margin-top: 0.5rem;
  }
  .troubleshooting > details {
    border-bottom: 1px solid var(--border-subtle);
  }
  .troubleshooting summary {
    padding: 1rem 0;
    cursor: pointer;
    font-weight: 500;
  }
  .troubleshooting details p {
    padding: 0 0.5rem;
  }
  .substitution {
    margin-bottom: 1.3rem;
  }
  .attribution {
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.7;
    margin-top: 2.5rem;
  }
  .step-check {
    display: none;
  }
  .cook-mode-active .step-check {
    display: inline-block;
    width: 22px;
    height: 22px;
    accent-color: var(--accent-gold);
    margin: 0 0.7rem 0.4rem 0;
    vertical-align: middle;
  }
  .cook-mode-active .recipe-method ol > li {
    font-size: 1.15rem;
    line-height: 1.8;
    padding-bottom: 1.5rem;
  }
  .cook-mode-active .ingredient-row {
    font-size: 1rem;
  }
  .cook-mode-active .completed-step > .step-copy {
    text-decoration: line-through;
    color: var(--text-secondary);
  }
  .cook-progress {
    margin-top: 1.5rem;
    font-size: 0.8rem;
  }
  #reset-progress {
    color: var(--accent-gold);
    text-decoration: underline;
    padding: 0.75rem 0;
  }
  #wake-status {
    font-size: 0.7rem;
    color: var(--text-secondary);
  }
  @media (max-width: 760px) {
    .recipe-body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .recipe-toolbar {
      top: 64px;
      gap: 0.5rem;
    }
    .jump-links {
      gap: 0.25rem;
    }
    .jump-links a {
      padding: 0.4rem 0.2rem;
      font-size: 0.75rem;
    }
    .recipe-actions button {
      padding: 0.45rem 0.7rem;
    }
  }
  @media print {
    .recipe-toolbar,
    .step-check,
    .cook-progress,
    #recipe-scaler,
    .recipe-details,
    .lesson-links {
      display: none !important;
    }
    [data-recipe-header] {
      display: block !important;
    }
    .recipe-body {
      display: block;
    }
    .ingredients-panel {
      margin-bottom: 1.5rem;
      border: 1px solid #bbb;
    }
    .ingredient-row input {
      display: none;
    }
    .ingredient-row:has(input:checked) [data-ingredient-text],
    .completed-step > .step-copy {
      text-decoration: none !important;
      color: black !important;
    }
    .recipe-method ol > li,
    .checkpoint {
      break-inside: avoid;
    }
    .prose-refined,
    .recipe-body,
    .recipe-main {
      break-inside: auto !important;
    }
    details > * {
      display: block !important;
    }
  }
</style>
