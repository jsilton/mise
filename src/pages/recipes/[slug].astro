---
import Layout from '../../layouts/Layout.astro';
import RecipeHeader from '../../components/RecipeHeader.astro';
import {
  parseRecipeContent,
  chefNoteHtml,
  isIngredientDivider,
  recipeDescription,
} from '../../lib/recipe-content.mjs';
import { buildRecipeSchema } from '../../lib/recipe-schema.mjs';
import RecipeScaler from '../../components/RecipeScaler.astro';
import { splitLeadingQuantity } from '../../lib/ingredient-quantity.mjs';
import { placeSwaps } from '../../lib/recipe-placement.mjs';
import { formulaShoppingList, formulaIngredients } from '../../lib/recipe-formula.mjs';
import { sourceParts } from '../../lib/source-brand.mjs';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await recipe.render();

const BASE = import.meta.env.BASE_URL;
// Internal page links end with a slash so they match the canonical URL and skip a redirect.
const withSlash = (href: string) =>
  href.startsWith(`${BASE}recipes/`) ||
  href.startsWith(`${BASE}meals/`) ||
  href.startsWith(`${BASE}learn/`)
    ? href.replace(/^([^?#]*[^/?#])(?=[?#]|$)/, '$1/')
    : href;
const learning = recipe.data.learning;
const allRecipes = await getCollection('recipes');
const recipeTitles = new Map(allRecipes.map((r) => [r.slug, r.data.title]));
const pairings = (recipe.data.pairsWith || []).filter((slug) => recipeTitles.has(slug));
const canonicalUrl = new URL(`${BASE}recipes/${recipe.slug}/`, Astro.site).href;

const isDivider = isIngredientDivider;
const parsedContent = parseRecipeContent(recipe.body || '');
const description = recipeDescription(recipe.data, parsedContent);
const schema = buildRecipeSchema(recipe.data, recipe.body || '', canonicalUrl, parsedContent);
const { byIngredient: swapsByIngredient, unplaced: otherSwaps } = placeSwaps(
  learning?.substitutions || [],
  recipe.data.ingredients || [],
  isIngredientDivider
);
const lowerFirst = (text: string) => text.replace(/^[A-Z](?![A-Z])/, (c) => c.toLowerCase());
// Fixes and ingredient swaps live in the recipe itself. Tips keeps storage, what to serve, and
// swaps that change the method rather than one ingredient.
const hasTips = Boolean(learning?.storage || pairings.length || otherSwaps.length);
const pairingNotes = recipe.data.pairingNotes || {};
const source = recipe.data.source ? sourceParts(recipe.data.source) : null;
// The note sits under the title. Recipe links inside it go to this site's pages.
const noteHtml = chefNoteHtml(recipe.body || '', (url) => {
  if (url.startsWith('/recipes/'))
    return withSlash(`${BASE}recipes/${url.slice('/recipes/'.length)}`);
  return /^(?:https?:\/\/|\/(?!\/))/.test(url) ? withSlash(url) : '';
});
// A shopping list is offered only when it combines lines, such as butter used in two places.
const shopping = recipe.data.formula ? formulaShoppingList(recipe.data.formula) : [];
const cookingLines = recipe.data.formula
  ? formulaIngredients(recipe.data.formula).filter((line) => !isIngredientDivider(line))
  : [];
const showShopping = shopping.length > 0 && shopping.length < cookingLines.length;

function getDividerLabel(str: string): string {
  const match = str.match(/^-{3}\s+(.+?)\s+-{3}$/);
  return match ? match[1] : str;
}

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function linkify(html: string): string {
  return html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, text, url) => {
    let href = url;
    if (!/^(?:https?:\/\/|\/(?!\/))/.test(href)) return text;
    if (href.startsWith('/recipes/')) {
      href = withSlash(`${BASE}recipes/${href.slice('/recipes/'.length)}`);
    }
    return `<a href="${withSlash(href)}" style="color: var(--accent-link);" class="hover:underline font-medium">${text}</a>`;
  });
}

// The amount is set in bold so it can be read at a glance from across the counter.
function parseIngredientHtml(str: string): string {
  const [quantity, rest] = splitLeadingQuantity(str);
  const lead = quantity ? `<b class="qty">${escapeHtml(quantity)}</b>` : '';
  return lead + linkify(escapeHtml(rest));
}
---

<Layout
  title={`${recipe.data.title} | Mise`}
  description={description}
  jsonLd={JSON.stringify(schema).replace(/</g, '\\u003c')}
>
  <RecipeHeader {recipe} {noteHtml} />
  <nav class="recipe-toolbar" aria-label="Recipe navigation">
    <div class="jump-links">
      <a href="#ingredients">Ingredients</a><a href="#directions">Method</a>{
        hasTips && <a href="#tips">Tips</a>
      }
    </div>
    <div class="section-switch" role="group" aria-label="Show recipe section">
      <button type="button" data-show="ingredients" aria-pressed="true">Ingredients</button>
      <button type="button" data-show="steps" aria-pressed="false">Steps</button>
      {
        hasTips && (
          <button type="button" data-show="tips" aria-pressed="false">
            Tips
          </button>
        )
      }
    </div>
    <div class="recipe-actions">
      <button id="print-recipe" hidden>Print</button><button id="cook-mode-toggle" hidden
        >Cook mode <span aria-hidden="true">→</span></button
      >
    </div>
  </nav>
  <article
    class="recipe-body"
    data-recipe-slug={recipe.slug}
    data-url={canonicalUrl}
    data-section="ingredients"
  >
    <aside class="ingredients-panel" aria-labelledby="ingredients">
      <h2 id="ingredients">Ingredients</h2>
      {
        recipe.data.servings && (
          <RecipeScaler
            servings={recipe.data.servings}
            scaling={recipe.data.scaling}
            formula={recipe.data.formula}
          />
        )
      }
      {
        showShopping && (
          <div class="list-switch" role="group" aria-label="Ingredient list">
            <button type="button" data-list="cook" aria-pressed="true">
              By recipe
            </button>
            <button type="button" data-list="shop" aria-pressed="false">
              Shopping list
            </button>
          </div>
        )
      }
      {
        showShopping && (
          <ul class="shopping-list" hidden>
            {shopping.map((line) => (
              <li data-formula-shopping set:html={parseIngredientHtml(line)} />
            ))}
          </ul>
        )
      }
      <ul class="ingredient-list">
        {
          (recipe.data.ingredients || []).map((ingredient, i) =>
            isDivider(ingredient) ? (
              <li class="ingredient-divider">{getDividerLabel(ingredient)}</li>
            ) : (
              <li class="ingredient-row">
                <input
                  id={`ingredient-${i}`}
                  type="checkbox"
                  data-ingredient-check={i}
                  aria-labelledby={`ingredient-label-${i}`}
                />
                <div class="ingredient-text">
                  <label
                    for={`ingredient-${i}`}
                    id={`ingredient-label-${i}`}
                    data-formula-index={recipe.data.formula ? i : undefined}
                    data-ingredient-text
                    set:html={parseIngredientHtml(ingredient)}
                  />
                  {(swapsByIngredient.get(i) || []).map((swap) => (
                    <p class="swap">
                      <span class="swap-tag">Swap</span> <strong>{swap.alternative}.</strong>{' '}
                      {swap.effect}
                    </p>
                  ))}
                </div>
              </li>
            )
          )
        }
      </ul>
      <button type="button" class="next-section" data-show="steps">
        Next: the steps <span aria-hidden="true">→</span>
      </button>
    </aside>
    <div class="recipe-main">
      <div class="recipe-steps">
        <button type="button" class="cook-start" data-cook hidden>
          Start cook mode <span aria-hidden="true">→</span>
          <span class="cook-start-note">One big step at a time, screen stays on</span>
        </button>
        <div class="recipe-method prose-refined"><Content /></div>
        {
          source && (
            <p class="attribution">
              {source.lead}
              {recipe.data.sourceUrl ? (
                <a href={recipe.data.sourceUrl} rel="noopener">
                  {source.name}
                </a>
              ) : (
                source.name
              )}
            </p>
          )
        }
      </div>
      {
        hasTips && (
          <div class="recipe-tips" id="tips">
            {otherSwaps.length > 0 && (
              <section class="prose-refined tip-card other-swaps">
                <h2>Other ways to make it</h2>
                {otherSwaps.map((swap) => (
                  <p class="swap">
                    <strong>
                      {swap.ingredient}: {lowerFirst(swap.alternative)}.
                    </strong>{' '}
                    {swap.effect}
                  </p>
                ))}
              </section>
            )}
            {learning?.storage && (
              <section class="prose-refined tip-card">
                <h2>Storing</h2>
                <p>{learning.storage}</p>
              </section>
            )}
            {pairings.length > 0 && (
              <section class="prose-refined pairings tip-card">
                <h2>Serve it with</h2>
                <ul>
                  {pairings.map((slug) => (
                    <li>
                      <a href={`${BASE}recipes/${slug}/`}>{recipeTitles.get(slug)}</a>
                      {pairingNotes[slug] && <span class="pairing-note">{pairingNotes[slug]}</span>}
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        )
      }
    </div>
  </article>
</Layout>
<script src="../../lib/recipe-page.ts"></script>
<style is:global>
  .recipe-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    margin: 1.5rem 0 2rem;
    position: sticky;
    top: 64px;
    z-index: 15;
    background: var(--bg-deep);
  }
  .jump-links,
  .recipe-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .jump-links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: var(--pill);
    color: var(--text-primary);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
  }
  .jump-links a:hover {
    border-color: var(--accent);
  }
  .recipe-actions button {
    min-height: 44px;
    padding: 0.6rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    border: 1px solid var(--border-emphasis);
    border-radius: var(--pill);
  }
  #cook-mode-toggle {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
    color: #fff;
    font-weight: 700;
    padding-inline: 1.4rem;
  }
  .recipe-body {
    display: grid;
    grid-template-columns: minmax(230px, 0.8fr) minmax(0, 1.6fr);
    gap: 3.5rem;
  }
  .ingredients-panel {
    align-self: start;
    padding: 1.4rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
  }
  .ingredients-panel h2 {
    font:
      650 1.9rem/1.2 'Fraunces',
      Georgia,
      serif;
  }
  .ingredient-list {
    list-style: none;
    padding: 0;
  }
  .ingredient-row {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1rem;
    line-height: 1.55;
    padding: 0.5rem 0;
  }
  .ingredient-text {
    min-width: 0;
  }
  .ingredient-row input {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-top: 0.1rem;
    accent-color: var(--accent-gold);
    cursor: pointer;
  }
  .ingredient-row:has(input:checked) [data-ingredient-text] {
    text-decoration: line-through;
    color: var(--text-secondary);
  }
  .ingredient-divider {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-strong);
    margin-top: 1.5rem;
  }
  .recipe-main {
    min-width: 0;
  }
  .recipe-method ol > li {
    padding-top: 0.5rem;
    margin-bottom: 1.6rem;
    font-size: 1.06rem;
    line-height: 1.7;
    color: var(--text-primary);
  }
  .recipe-method ol > li::before {
    top: 0.65rem;
  }
  /* Swaps sit under the ingredient they replace. */
  .swap {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0.3rem 0 0.2rem;
  }
  .swap strong {
    color: var(--text-primary);
    font-weight: 700;
  }
  .swap-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent-strong);
    background: var(--wash);
    border-radius: var(--pill);
    padding: 0.05rem 0.5rem;
    margin-right: 0.15rem;
  }
  .other-swaps .swap {
    font-size: 0.95rem;
    margin: 0 0 0.8rem;
  }
  .attribution a,
  .pairing-note a {
    color: var(--accent-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .pairings li {
    margin-bottom: 0.6rem;
  }
  .pairing-note {
    display: block;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .list-switch {
    display: flex;
    gap: 0.3rem;
    background: var(--bg-elevated);
    border-radius: var(--pill);
    padding: 0.25rem;
    margin: 0 0 0.8rem;
  }
  .list-switch button {
    flex: 1;
    min-height: 40px;
    border-radius: var(--pill);
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
  .list-switch button[aria-pressed='true'] {
    background: var(--bg-surface);
    color: var(--text-primary);
    box-shadow: 0 1px 4px rgba(31, 52, 64, 0.15);
  }
  .shopping-list {
    list-style: none;
    padding: 0;
  }
  .shopping-list li {
    font-size: 1rem;
    line-height: 1.55;
    padding: 0.5rem 0;
  }
  .attribution {
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.7;
    margin-top: 2.5rem;
  }
  .qty {
    font-weight: 750;
    color: var(--text-primary);
  }
  .section-switch,
  .next-section,
  .cook-start {
    display: none;
  }
  .recipe-tips {
    margin-top: 3rem;
    display: grid;
    gap: 1.2rem;
  }
  .recipe-tips h2 {
    font:
      650 1.5rem/1.2 'Fraunces',
      Georgia,
      serif;
    margin: 0 0 0.6rem;
  }
  .tip-card {
    padding: 1.1rem 1.3rem;
    border-radius: var(--radius);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
  }
  .tip-card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.2rem;
  }
  .tip-card p {
    margin: 0;
  }
  .recipe-actions #cook-mode-toggle {
    min-height: 48px;
    font-size: 0.95rem;
  }

  /* Cook mode: one big step at a time, with the ingredients a tap away. */
  .cook-dialog {
    width: 100%;
    max-width: 760px;
    height: 100%;
    max-height: 100%;
    margin: 0 auto;
    padding: 0;
    border: 0;
    background: var(--bg-deep);
    color: var(--text-primary);
  }
  .cook-dialog::backdrop {
    background: rgba(20, 35, 44, 0.6);
  }
  .cook-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .cook-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    background: var(--accent);
    color: #fff;
  }
  .cook-title {
    font:
      650 1.05rem/1.2 'Fraunces',
      Georgia,
      serif;
    margin: 0;
  }
  .cook-awake {
    font-size: 0.78rem;
    margin: 0.15rem 0 0;
    color: #e6eef1;
  }
  .cook-head-actions {
    display: flex;
    gap: 0.4rem;
    flex: none;
  }
  .cook-head button {
    min-height: 44px;
    padding: 0.4rem 0.9rem;
    border-radius: var(--pill);
    border: 2px solid rgba(255, 255, 255, 0.8);
    color: #fff;
    font-weight: 700;
    font-size: 0.88rem;
  }
  .cook-head .cook-ings[aria-expanded='true'] {
    background: #fff;
    color: var(--text-primary);
  }
  .cook-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.4rem 1.2rem 2rem;
  }
  .cook-count {
    display: inline-block;
    font-weight: 800;
    font-size: 0.85rem;
    background: var(--apricot);
    color: var(--on-apricot);
    border-radius: var(--pill);
    padding: 0.25rem 0.8rem;
    margin: 0 0 1rem;
  }
  .cook-scaled {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0 0 0.8rem;
  }
  .cook-text .step-copy {
    font-size: 1.45rem;
    line-height: 1.55;
  }
  .cook-text .step-copy p {
    margin: 0 0 0.8rem;
  }
  .cook-ing-panel {
    margin-bottom: 1.4rem;
    padding: 1rem 1.1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
  }
  .cook-ing-h {
    font-weight: 800;
    margin: 0 0 0.4rem;
  }
  .cook-ing-panel ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cook-ing-panel li {
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 1.05rem;
  }
  .cook-ing-panel li.divider {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-strong);
    border: 0;
    padding-top: 0.9rem;
  }
  .cook-foot {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 0.6rem;
    padding: 0.8rem 1rem calc(0.8rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-surface);
  }
  .cook-foot button {
    min-height: 56px;
    border-radius: var(--pill);
    font-weight: 800;
    font-size: 1.05rem;
    border: 2px solid var(--accent-strong);
    color: var(--accent-strong);
  }
  .cook-foot .cook-next {
    background: var(--accent-strong);
    color: #fff;
  }
  .cook-foot button:disabled {
    opacity: 0.35;
  }
  @media (max-width: 760px) {
    .recipe-body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    /* On a phone the recipe is three short sections, not one long scroll. */
    .jump-links {
      display: none !important;
    }
    .section-switch {
      display: flex;
      flex: 1;
      gap: 0.3rem;
      background: var(--bg-elevated);
      border-radius: var(--pill);
      padding: 0.25rem;
    }
    .section-switch button {
      flex: 1;
      min-height: 44px;
      border-radius: var(--pill);
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--text-secondary);
    }
    .section-switch button[aria-pressed='true'] {
      background: var(--bg-surface);
      color: var(--text-primary);
      box-shadow: 0 1px 4px rgba(31, 52, 64, 0.15);
    }
    /* Only the section switch stays pinned on a phone; cook mode starts from the Steps section. */
    .recipe-actions {
      display: none;
    }
    .recipe-toolbar {
      padding: 0.5rem 0;
      margin: 1.2rem 0 1.4rem;
    }
    .cook-start:not([hidden]) {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      margin: 0 0 1.4rem;
      padding: 0.8rem 1rem;
      border-radius: var(--radius);
      background: var(--accent-strong);
      color: #fff;
      font-weight: 800;
      font-size: 1.1rem;
    }
    .cook-start-note {
      font-weight: 500;
      font-size: 0.82rem;
      color: #e6eef1;
    }
    .next-section {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.4rem;
      width: 100%;
      min-height: 48px;
      margin-top: 1.4rem;
      border-radius: var(--pill);
      border: 2px solid var(--accent-strong);
      color: var(--accent-strong);
      font-weight: 800;
    }
    .recipe-body[data-section='ingredients'] .recipe-main,
    .recipe-body[data-section='steps'] .ingredients-panel,
    .recipe-body[data-section='steps'] .recipe-tips,
    .recipe-body[data-section='tips'] .ingredients-panel,
    .recipe-body[data-section='tips'] .recipe-steps {
      display: none;
    }
    .recipe-body[data-section='tips'] .recipe-tips {
      margin-top: 0;
    }
    .cook-text .step-copy {
      font-size: 1.3rem;
    }
    .recipe-toolbar {
      top: 64px;
      gap: 0.5rem;
    }
    .jump-links {
      gap: 0.25rem;
    }
    .jump-links a {
      padding: 0.4rem 0.2rem;
      font-size: 0.75rem;
    }
    .recipe-actions button {
      padding: 0.45rem 0.7rem;
    }
  }
  @media print {
    .recipe-body .recipe-main,
    .recipe-body .ingredients-panel,
    .recipe-body .recipe-tips,
    .recipe-body .recipe-steps {
      display: block !important;
    }
    .next-section,
    .recipe-toolbar,
    .step-check,
    .cook-progress,
    #recipe-scaler,
    .recipe-details,
    .lesson-links {
      display: none !important;
    }
    [data-recipe-header] {
      display: block !important;
    }
    .recipe-body {
      display: block;
    }
    .ingredients-panel {
      margin-bottom: 1.5rem;
      border: 1px solid #bbb;
