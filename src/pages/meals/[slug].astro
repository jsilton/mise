---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const meals = await getCollection('meals');
  return meals.map((meal) => ({
    params: { slug: meal.slug },
    props: { meal },
  }));
}

const { meal } = Astro.props;
const { Content } = await meal.render();

// Get recipe collection for linking
const recipes = await getCollection('recipes');
const recipeMap = new Map(recipes.map((r) => [r.slug, r]));

// Helper to get recipe details
function getRecipe(slug: string) {
  return recipeMap.get(slug);
}

function getRecipeTitle(slug: string): string {
  const recipe = recipeMap.get(slug);
  return recipe?.data.title || slug;
}

// Template display info
const templateLabels: Record<string, string> = {
  plate: 'Plate',
  bowl: 'Bowl',
  'pasta-night': 'Pasta Night',
  'soup-and-side': 'Soup & Side',
  'one-pot': 'One-Pot',
  grazing: 'Grazing',
};

const templateColors: Record<string, { bg: string; text: string }> = Object.fromEntries(
  Object.keys(templateLabels).map((key) => [
    key,
    { bg: 'var(--bg-elevated)', text: 'var(--accent)' },
  ])
);
---

<Layout title={`${meal.data.title} | Meals | Mise`}>
  <div class="max-w-3xl mx-auto">
    {/* Breadcrumb */}
    <nav class="mb-8">
      <a
        href={`${import.meta.env.BASE_URL}meals`}
        class="breadcrumb-link inline-flex items-center gap-1.5 text-sm transition-colors"
        style="color: var(--text-tertiary);"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"
          ></path>
        </svg>
        Back to Meals
      </a>
    </nav>

    {/* Header Card */}
    <header
      data-meal-header
      class="mb-8 rounded-2xl overflow-hidden"
      style={`background: var(--bg-surface);`}
    >
      <div class="p-6 sm:p-8">
        <img
          class="print-wordmark"
          src={`${import.meta.env.BASE_URL}brand/mise-wordmark.svg`}
          alt="mise."
        />
        <div class="flex items-start justify-between gap-4 mb-5">
          <h1
            class="font-display text-2xl sm:text-3xl font-bold tracking-tight leading-tight"
            style="color: var(--text-primary);"
          >
            {meal.data.title}
          </h1>
          {
            meal.data.template && (
              <span
                class="shrink-0 inline-flex items-center px-3 py-1 rounded-full text-sm font-bold"
                style={`background: ${templateColors[meal.data.template]?.bg || 'var(--bg-hover)'}; color: ${templateColors[meal.data.template]?.text || 'var(--text-secondary)'};`}
              >
                {templateLabels[meal.data.template] || meal.data.template}
              </span>
            )
          }
        </div>

        {/* Meal facts */}
        {
          (meal.data.servings ||
            meal.data.totalTime ||
            meal.data.totalPrepTime ||
            meal.data.totalCookTime ||
            meal.data.totalActiveTime) && (
            <div class="flex flex-wrap gap-6 text-sm">
              {meal.data.servings && (
                <div class="flex items-center gap-2" data-meal-servings>
                  <span style="color: var(--text-tertiary);">Serves:</span>
                  <span class="font-medium" style="color: var(--text-secondary);">
                    {meal.data.servings}
                  </span>
                </div>
              )}
              {meal.data.totalTime && (
                <div class="flex items-center gap-2">
                  <span style="color: var(--text-tertiary);">Elapsed:</span>
                  <span class="font-medium" style="color: var(--text-secondary);">
                    {meal.data.totalTime}
                  </span>
                </div>
              )}
              {meal.data.totalActiveTime && (
                <div class="flex items-center gap-2">
                  <svg
                    class="w-4 h-4"
                    style="color: var(--accent-gold);"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                  <span style="color: var(--text-tertiary);">Active:</span>
                  <span class="font-medium" style="color: var(--text-secondary);">
                    {meal.data.totalActiveTime}
                  </span>
                </div>
              )}
              {meal.data.totalPrepTime && (
                <div class="flex items-center gap-2">
                  <span style="color: var(--text-tertiary);">Prep:</span>
                  <span class="font-medium" style="color: var(--text-secondary);">
                    {meal.data.totalPrepTime}
                  </span>
                </div>
              )}
              {meal.data.totalCookTime && (
                <div class="flex items-center gap-2">
                  <span style="color: var(--text-tertiary);">Cook:</span>
                  <span class="font-medium" style="color: var(--text-secondary);">
                    {meal.data.totalCookTime}
                  </span>
                </div>
              )}
            </div>
          )
        }
      </div>
    </header>

    {/* Recipe Components */}
    {
      meal.data.componentPreparation && (
        <section class="mb-8" aria-label="Meal preparation">
          <h2 class="text-lg font-semibold mb-3">Before you start</h2>
          <ul class="space-y-2">
            {Object.entries(meal.data.componentPreparation).map(([slug, prep]) => (
              <li>
                <strong>{getRecipeTitle(slug)}:</strong>{' '}
                {
                  {
                    'from-scratch': 'Make from scratch',
                    'prepared-ahead': 'Prepare ahead',
                    reheat: 'Use cooked and chilled',
                  }[prep.state]
                }
                . {prep.note}
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <section data-meal-components class="mb-8">
      <h2 class="sec-h">Recipes in this meal</h2>
      <div
        class="rounded-xl overflow-hidden"
        style={`background: var(--bg-surface); border: 1px solid var(--border-subtle);`}
      >
        {
          meal.data.main && (
            <a
              href={`${import.meta.env.BASE_URL}recipes/${meal.data.main}`}
              class="recipe-link flex items-center gap-4 p-4 transition-colors group"
            >
              <span class="role-tag">Main</span>
              <span
                class="recipe-link-name flex-1 font-medium transition-colors"
                style="color: var(--text-primary);"
              >
                {getRecipeTitle(meal.data.main)}
              </span>
              <svg
                class="recipe-link-arrow w-4 h-4"
                style="color: var(--text-tertiary);"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </a>
          )
        }

        {
          meal.data.sides &&
            meal.data.sides.map((side) => (
              <a
                href={`${import.meta.env.BASE_URL}recipes/${side}`}
                class="recipe-link flex items-center gap-4 p-4 transition-colors group"
              >
                <span class="role-tag">Side</span>
                <span
                  class="recipe-link-name flex-1 font-medium transition-colors"
                  style="color: var(--text-primary);"
                >
                  {getRecipeTitle(side)}
                </span>
                <svg
                  class="recipe-link-arrow w-4 h-4"
                  style="color: var(--text-tertiary);"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>
            ))
        }

        {
          meal.data.base && (
            <a
              href={`${import.meta.env.BASE_URL}recipes/${meal.data.base}`}
              class="recipe-link flex items-center gap-4 p-4 transition-colors group"
            >
              <span class="role-tag">Base</span>
              <span
                class="recipe-link-name flex-1 font-medium transition-colors"
                style="color: var(--text-primary);"
              >
                {getRecipeTitle(meal.data.base)}
              </span>
              <svg
                class="recipe-link-arrow w-4 h-4"
                style="color: var(--text-tertiary);"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </a>
          )
        }

        {
          meal.data.salad && (
            <a
              href={`${import.meta.env.BASE_URL}recipes/${meal.data.salad}`}
              class="recipe-link flex items-center gap-4 p-4 transition-colors group"
            >
              <span class="role-tag">Salad</span>
              <span
                class="recipe-link-name flex-1 font-medium transition-colors"
                style="color: var(--text-primary);"
              >
                {getRecipeTitle(meal.data.salad)}
              </span>
              <svg
                class="recipe-link-arrow w-4 h-4"
                style="color: var(--text-tertiary);"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </a>
          )
        }

        {
          meal.data.sauce && (
            <a
              href={`${import.meta.env.BASE_URL}recipes/${meal.data.sauce}`}
              class="recipe-link flex items-center gap-4 p-4 transition-colors group"
            >
              <span class="role-tag">Sauce</span>
              <span
                class="recipe-link-name flex-1 font-medium transition-colors"
                style="color: var(--text-primary);"
              >
                {getRecipeTitle(meal.data.sauce)}
              </span>
              <svg
                class="recipe-link-arrow w-4 h-4"
                style="color: var(--text-tertiary);"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </a>
          )
        }

        {
          meal.data.dessert && (
            <a
              href={`${import.meta.env.BASE_URL}recipes/${meal.data.dessert}`}
              class="recipe-link flex items-center gap-4 p-4 transition-colors group"
            >
              <span class="role-tag">Dessert</span>
              <span
                class="recipe-link-name flex-1 font-medium transition-colors"
                style="color: var(--text-primary);"
              >
                {getRecipeTitle(meal.data.dessert)}
              </span>
              <svg
                class="recipe-link-arrow w-4 h-4"
                style="color: var(--text-tertiary);"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </a>
          )
        }
      </div>
    </section>

    {/* Cuisines */}
    {
      meal.data.cuisines && meal.data.cuisines.length > 0 && (
        <section data-meal-tags class="mb-8">
          <h2 class="sec-h">Cuisines</h2>
          <div class="flex flex-wrap gap-2">
            {meal.data.cuisines.map((cuisine) => (
              <span
                class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-lg"
                style="background: var(--bg-elevated); color: var(--accent); border: 1px solid var(--border-subtle);"
              >
                {cuisine}
              </span>
            ))}
          </div>
        </section>
      )
    }

    {/* Notes from markdown body */}
    <section
      data-meal-notes
      class="rounded-2xl p-6 sm:p-8 prose-refined"
      style={`background: var(--bg-surface); border: 1px solid var(--border-subtle);`}
    >
      <Content />
    </section>
  </div>
</Layout>

<style>
  .sec-h {
    font:
      650 1.4rem/1.2 'Fraunces',
      Georgia,
      serif;
    color: var(--text-primary);
    margin: 0 0 0.8rem;
  }
  /* The course sits in a small pill beside the recipe name, in sentence case like the rest of the site. */
  .role-tag {
    flex: none;
    width: 4.6rem;
    text-align: center;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--wash);
    color: var(--accent-strong);
    font-size: 0.82rem;
    font-weight: 700;
  }
  .print-wordmark {
    display: none;
  }
  @media print {
    [data-meal-header] {
      display: block !important;
      break-inside: avoid;
    }
    [data-meal-header],
    [data-meal-components],
    [data-meal-tags] {
      margin-bottom: 4mm !important;
    }
    [data-meal-header] > div,
    [data-meal-notes] {
      padding: 3mm !important;
    }
    .recipe-link {
      padding: 2mm 3mm !important;
    }
    .print-wordmark {
      display: block;
      width: 24mm;
      height: auto;
      margin-bottom: 3mm;
    }
  }
  .breadcrumb-link:hover {
    color: var(--accent-gold) !important;
  }
  .recipe-link:hover {
    background: var(--bg-hover);
  }
  .recipe-link:hover .recipe-link-name {
    color: var(--accent-gold) !important;
  }
  .recipe-link:hover .recipe-link-arrow {
    color: var(--accent-gold) !important;
  }
</style>
