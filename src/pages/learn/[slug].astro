---
import Layout from '../../layouts/Layout.astro';
import { techniques } from '../../data/techniques';
import { getCollection } from 'astro:content';
import LeaveningComparison from '../../components/LeaveningComparison.astro';
import DishArt from '../../components/DishArt.astro';
import { timeBand } from '../../lib/time-band.mjs';
export function getStaticPaths() {
  return techniques.map((technique) => ({
    params: { slug: technique.slug },
    props: { technique },
  }));
}
const { technique } = Astro.props;
const BASE = import.meta.env.BASE_URL;
const recipes = await getCollection('recipes');
const practice = technique.recipes.map((slug) => {
  const recipe = recipes.find((r) => r.slug === slug);
  if (!recipe) throw new Error(`Missing practice recipe for ${technique.slug}: ${slug}`);
  return recipe;
});
---

<Layout title={`${technique.title} | Mise`} description={technique.summary}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={`${BASE}learn`}>The learning kitchen</a><span aria-hidden="true">/</span><span
      >{technique.category}</span
    >
  </nav>
  <div class="lesson-hero">
    <p class="eyebrow">{technique.category}</p><h1>{technique.title}</h1><p>{technique.summary}</p>
  </div>
  <div class="lesson-layout">
    <aside class="lesson-toc">
      <p class="eyebrow">In this lesson</p><nav aria-label="Lesson sections">
        <a href="#principle">The science</a>
        {technique.slug === 'leavening' && <a href="#leaveners">Compare leaveners</a>}
        <a href="#controls">What you control</a><a href="#cues">Read the cues</a><a href="#rescue"
          >Troubleshoot</a
        ><a href="#experiment">Try a comparison</a><a href="#practice">Cook to learn</a>
      </nav>
    </aside>
    <div class="prose-refined lesson-content">
      <section id="principle">
        <h2>The science, in plain language</h2><p>{technique.principle}</p>
      </section>
      {technique.slug === 'leavening' && <LeaveningComparison />}
      <section id="controls">
        <h2>What you control</h2>{
          technique.controls.map((control, i) => (
            <div class="control">
              <>
                <span class="control-number">0{i + 1}</span>
                <div>
                  <>
                    <h3>{control.name}</h3>
                    <p>
                      <strong>{control.action}</strong>
                    </p>
                    <p>{control.reason}</p>
                  </>
                </div>
              </>
            </div>
          ))
        }
      </section>
      <section id="cues">
        <h2>Read the cues</h2><p>
          Watch the food as well as the clock. These observations help you decide your next move.
        </p><div class="cue-track">
          {
            technique.cues.map((cue) => (
              <div class="cue-card">
                <span class="cue-stage">{cue.stage}</span>
                <p>{cue.cue}</p>
              </div>
            ))
          }
        </div>
      </section>
      <section id="rescue">
        <h2>When it goes differently</h2>{
          technique.troubleshooting.map((item) => (
            <details>
              <>
                <summary>{item.problem}</summary>
                <p>
                  <strong>Likely cause:</strong> {item.cause}
                </p>
                <p>
                  <strong>Try this:</strong> {item.fix}
                </p>
              </>
            </details>
          ))
        }
      </section>
      <section id="experiment" class="experiment">
        <p class="eyebrow">Build your cooking intuition</p><h2>
          Change one thing. Notice the difference.
        </h2><p>{technique.experiment}</p><p class="experiment-note">
          This is a suggested comparison for your kitchen, not a claim of a completed Mise test.
        </p>
      </section>
      <section id="practice">
        <h2>Cook to learn</h2><p>
          Put the idea into practice with a recipe from the collection.
        </p><div class="practice-list">
          {
            practice.map((recipe) => {
              const time = timeBand(recipe.data.totalTime);
              return (
                <a class="practice-card" href={`${BASE}recipes/${recipe.slug}`}>
                  <DishArt slug={recipe.slug} />
                  <div>
                    <span class="practice-title">{recipe.data.title}</span>
                    <small>{recipe.data.learning?.focus || 'Explore this recipe'}</small>
                    {time.minutes > 0 && (
                      <span class="time-chip" data-band={time.band}>
                        {time.short}
                      </span>
                    )}
                  </div>
                </a>
              );
            })
          }
        </div>
      </section>
      <section class="sources">
        <h2>Sources & further reading</h2><p>
          Sources support the underlying principles. The practical checks and comparisons are Mise’s
          editorial guidance.
        </p><ul>
          {
            technique.sources.map((source) => (
              <li>
                <a href={source.url}>{source.title} ↗</a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Layout>
<style>
  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }
  .lesson-hero {
    margin: 0 0 2rem;
    padding: 2.2rem 0 2.4rem;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 0 100vmax var(--accent);
    clip-path: inset(0 -100vmax);
  }
  .lesson-hero .eyebrow {
    color: #e6eef1;
  }
  h1 {
    font:
      650 clamp(2.5rem, 5vw, 4.2rem)/1.08 'Fraunces',
      Georgia,
      serif;
    letter-spacing: -0.03em;
    margin: 0.7rem 0;
  }
  .lesson-hero > p:last-child {
    color: #f7f6f2;
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 46rem;
  }
  .lesson-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 4rem;
  }
  .lesson-toc {
    align-self: start;
    position: sticky;
    top: 100px;
    min-width: 0;
  }
  .lesson-toc nav {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.8rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .lesson-toc nav a {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 0.3rem 0.9rem;
    border-radius: var(--pill);
    color: var(--text-primary);
  }
  .lesson-toc nav a:hover {
    background: var(--wash);
  }
  .lesson-content section {
    margin-bottom: 3rem;
  }
  .control {
    display: flex;
    gap: 1rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .control h3 {
    margin-top: 0;
  }
  .control p {
    margin-bottom: 0.5rem;
  }
  /* Numbered like recipe steps. */
  .control-number {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--wash);
    color: var(--accent-strong);
    font-weight: 800;
    font-size: 0.85rem;
  }
  /* Cues read like the recipe pages' "Perfect your technique" callouts. */
  .cue-track {
    display: grid;
    gap: 0.8rem;
  }
  .cue-card {
    background: var(--wash);
    border-radius: var(--radius-sm);
    padding: 1rem 1.1rem;
  }
  .cue-stage {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent-strong);
    border-radius: var(--pill);
    padding: 0.2rem 0.65rem;
  }
  .cue-card p {
    margin: 0.5rem 0 0;
  }
  details {
    border-bottom: 1px solid var(--border-subtle);
  }
  summary {
    padding: 1rem 0;
    cursor: pointer;
    font-weight: 600;
  }
  .experiment {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 1.6rem;
  }
  .experiment h2 {
    margin-top: 1rem;
    border: 0;
  }
  .experiment-note {
    font-size: 0.8rem;
  }
  .practice-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 0.9rem;
  }
  .practice-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    background: var(--bg-surface);
    overflow: hidden;
    text-decoration: none !important;
  }
  .practice-card:hover {
    border-color: var(--accent-muted);
  }
  .practice-card :global(.dish-art) {
    background: var(--bg-elevated);
  }
  .practice-card > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 0.9rem 1rem 1rem;
  }
  .practice-title {
    font:
      650 1.1rem/1.25 'Fraunces',
      Georgia,
      serif;
    color: var(--text-primary);
  }
  .practice-card small {
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .sources p {
    font-size: 0.85rem;
  }
  @media (max-width: 700px) {
    .lesson-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }
    /* On a phone the lesson sections become one pinned row you can swipe. */
    .lesson-toc {
      top: 64px;
      z-index: 10;
      background: var(--bg-deep);
      margin: 0 -1rem;
      padding: 0.4rem 0;
    }
    .lesson-toc > .eyebrow {
      display: none;
    }
    .lesson-toc nav {
      flex-direction: row;
      overflow-x: auto;
      scrollbar-width: none;
      margin: 0;
      padding: 0 1rem;
    }
    .lesson-toc nav::-webkit-scrollbar {
      display: none;
    }
    .lesson-toc nav a {
      flex: none;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
    }
    .lesson-content section {
      scroll-margin-top: 130px;
    }
  }
</style>
