---
import DishArt from '../components/DishArt.astro';
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import FilterPanel from '../components/FilterPanel.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getCollection } from 'astro:content';
import { getTechniquesForRecipe } from '../data/techniques';
import { timeBand, formatMinutes } from '../lib/time-band.mjs';
import type { RecipeSearchItem } from '../lib/fuzzySearch';

const recipes = (await getCollection('recipes')).filter(
  (r) => !['no-cook-playdough', 'play-dough'].includes(r.slug)
);
const BASE = import.meta.env.BASE_URL;
const featuredSlugs = ['authentic-roman-alfredo', 'crispy-parmesan-roasted-broccoli', 'dal-tadka'];
const featured = featuredSlugs.map((slug) => recipes.find((r) => r.slug === slug)).filter(Boolean);
recipes.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Prepare search index data - convert recipes to searchable format
const searchIndexData: RecipeSearchItem[] = recipes.map((recipe) => ({
  slug: recipe.slug,
  title: recipe.data.title,
  cuisines: recipe.data.cuisines,
  ingredients: recipe.data.ingredients,
  flavorProfile: recipe.data.flavorProfile,
  cookingMethods: [
    ...(recipe.data.cookingMethods || []),
    ...getTechniquesForRecipe(recipe).map((t) => t.title),
    ...(recipe.data.learning ? [recipe.data.learning.focus] : []),
  ],
  origin: recipe.data.origin,
}));
---

<Layout
  title="Mise | Cook with understanding"
  description="A recipe collection and learning kitchen. Explore the science, recognize the cues, and understand what makes your cooking work."
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">A collection. A practice. A better cook.</p><h1 id="home-title">
        Good food starts<br />with a recipe.<br /><em>Great cooking<br />starts with why.</em>
      </h1><p class="hero-description">
        Learn what the heat is doing. Know what to look for. Find the confidence to make a recipe
        your own.
      </p><div class="hero-actions">
        <a class="primary-link" href="#collection"
          >Find your next recipe <span aria-hidden="true">↓</span></a
        ><a href={`${BASE}learn`}>Explore the learning kitchen ↗</a>
      </div>
    </div>
    <a
      class="hero-study"
      href={`${BASE}learn/emulsions`}
      aria-label="Inside a silky sauce: explore the emulsion lesson"
    >
      <div class="study-header">
        <span class="eyebrow">A closer look · 01</span><span class="study-arrow" aria-hidden="true"
          >↗</span
        >
      </div>
      <DishArt slug="authentic-roman-alfredo" eager />
      <div class="study-caption">
        <p class="eyebrow">Fat + water + movement</p><h2>Inside a silky sauce.</h2><p>
          Butter and water want to separate.<br />Your technique brings them together.
        </p><span class="study-foot">Understand emulsions <span aria-hidden="true">→</span></span>
      </div>
    </a>
  </section>
  <section class="featured-section" aria-labelledby="featured-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Cook something. Learn something.</p><h2 id="featured-title">
          Three recipes, three useful lessons.
        </h2>
      </div><a href={`${BASE}learn`}>All lessons ↗</a>
    </div><div class="featured-grid">
      {
        featured.map((recipe, i) => (
          <a class="featured-recipe" href={`${BASE}recipes/${recipe.slug}`}>
            <>
              <>
                <DishArt slug={recipe.slug} />
                <span class="feature-number">0{i + 1}</span>
              </>
              <p class="eyebrow">{recipe.data.learning.focus}</p>
              <h3>{recipe.data.title}</h3>
              <p>{recipe.data.learning.outcome}</p>
              <span class="feature-meta">
                <span class="time-chip" data-band={timeBand(recipe.data.totalTime).band}>
                  {formatMinutes(timeBand(recipe.data.totalTime).minutes) || recipe.data.totalTime}
                </span>
                <span class="capitalize">{recipe.data.difficulty}</span>
                <span aria-hidden="true">↗</span>
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section id="collection" aria-labelledby="collection-title">
    <div class="collection-heading">
      <div>
        <p class="eyebrow">The recipe collection</p><h2 id="collection-title">
          What will you cook next?
        </h2><p>
          {recipes.length} recipes to explore. Search an ingredient, a dish, or a technique.
        </p>
      </div><div class="collection-search">
        <SearchBar id="searchInput" placeholder="Try chicken, lentils, or browning…" />
      </div>
    </div>
    <!-- Filter and Sort UI -->
    <FilterPanel {recipes} />

    <p
      id="result-count"
      role="status"
      aria-live="polite"
      class="text-sm mb-4"
      style="color:var(--text-secondary)"
    >
      {recipes.length} recipes
    </p>
    <!-- Recipe Grid -->
    <div id="recipeGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {recipes.map((recipe) => <RecipeCard {recipe} />)}
    </div>

    <!-- No Results State -->
    <div id="noResults" class="hidden text-center py-20">
      <div
        class="inline-flex items-center justify-center w-16 h-16 rounded-full mb-4"
        style="background: var(--bg-elevated);"
      >
        <svg
          class="w-8 h-8"
          style="color: var(--text-tertiary);"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          ></path>
        </svg>
      </div>
      <h3 class="text-lg font-medium" style="color: var(--text-primary);">No recipes found</h3>
      <p class="mt-1" style="color: var(--text-secondary);">
        Try adjusting your search terms or filters.
      </p>
      <button
        id="clearSearch"
        class="mt-4 text-sm font-medium hover:underline"
        style="color: var(--accent-gold);"
      >
        Reset search and filters
      </button>
    </div>
  </section>
</Layout>

<script define:vars={{ searchIndexData }}>
  window.__searchIndexData = searchIndexData;
</script>

<script>
  import Fuse from 'fuse.js';
  import { timeToMinutes } from '../lib/time.mjs';

  // Initialize fuzzy search index from server-injected data
  const searchIndexData = (window as any).__searchIndexData;
  const fuse = new Fuse(searchIndexData, {
    keys: [
      { name: 'title', weight: 10 },
      { name: 'ingredients', weight: 5 },
      { name: 'cuisines', weight: 3 },
      { name: 'flavorProfile', weight: 2 },
      { name: 'cookingMethods', weight: 2 },
      { name: 'origin', weight: 2 },
    ],
    threshold: 0.35,
    minMatchCharLength: 2,
    includeScore: true,
  });

  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const recipeCards = document.querySelectorAll('.recipe-card');
  const noResults = document.getElementById('noResults');
  const clearSearchBtn = document.getElementById('clearSearch');

  function updateUrlParams() {
    const params = new URLSearchParams();
    const query = searchInput?.value?.trim() || '';
    if (query) {
      params.set('q', query);
    }

    const state = (window as any).filterState || {};
    if (state.difficulty) params.set('difficulty', state.difficulty);
    if (state.role) params.set('role', state.role);
    if (state.vibe) params.set('vibe', state.vibe);
    if (state.cuisine) params.set('cuisine', state.cuisine);
    if (state.dietary) params.set('dietary', state.dietary);
    if (state.cookingMethod) params.set('method', state.cookingMethod);
    if (state.occasion) params.set('occasion', state.occasion);
    if (state.flavor) params.set('flavor', state.flavor);
    if (state.sortMode && state.sortMode !== 'title') {
      params.set('sort', state.sortMode);
    }

    const queryString = params.toString();
    const newUrl = queryString ? `?${queryString}` : window.location.pathname;
    history.replaceState(null, '', newUrl);
  }

  function applyFiltersAndSort() {
    const query = searchInput?.value?.toLowerCase() || '';
    const state = (window as any).filterState || {};

    let visibleCards: { card: Element; difficulty: string; prepTime: string }[] = [];

    if (query.trim()) {
      const fuzzyResults = fuse.search(query.trim());
      const fuzzySlugSet = new Set(fuzzyResults.map((r) => r.item.slug));

      recipeCards.forEach((card) => {
        const el = card as HTMLElement;
        const slug = el.getAttribute('href')?.split('/').pop();
        const cardDifficulty = el.dataset.difficulty || '';
        const cardRole = el.dataset.role || '';
        const cardVibe = el.dataset.vibe || '';
        const cardCuisines = el.dataset.cuisines?.split(',').filter((c) => c) || [];
        const cardDietary = el.dataset.dietary?.split(',').filter((d) => d) || [];
        const cardMethods = el.dataset.cookingMethods?.split(',').filter((m) => m) || [];
        const cardOccasions = el.dataset.occasions?.split(',').filter((o) => o) || [];
        const cardFlavors = el.dataset.flavorProfile?.split(',').filter((f) => f) || [];

        const matchesFuzzySearch = fuzzySlugSet.has(slug);
        const matchesDifficulty = !state.difficulty || cardDifficulty === state.difficulty;
        const matchesRole = !state.role || cardRole === state.role;
        const matchesVibe = !state.vibe || cardVibe === state.vibe;
        const matchesCuisine = !state.cuisine || cardCuisines.includes(state.cuisine);
        const matchesDietary = !state.dietary || cardDietary.includes(state.dietary);
        const matchesMethod = !state.cookingMethod || cardMethods.includes(state.cookingMethod);
        const matchesOccasion = !state.occasion || cardOccasions.includes(state.occasion);
        const matchesFlavor = !state.flavor || cardFlavors.includes(state.flavor);

        const isVisible =
          matchesFuzzySearch &&
          matchesDifficulty &&
          matchesRole &&
          matchesVibe &&
          matchesCuisine &&
          matchesDietary &&
          matchesMethod &&
          matchesOccasion &&
          matchesFlavor;

        if (isVisible) {
          el.style.display = 'flex';
          visibleCards.push({
            card: el,
            difficulty: cardDifficulty,
            prepTime: el.dataset.prepTime || '',
          });
        } else {
          el.style.display = 'none';
        }
      });
    } else {
      recipeCards.forEach((card) => {
        const el = card as HTMLElement;
        const cardDifficulty = el.dataset.difficulty || '';
        const cardRole = el.dataset.role || '';
        const cardVibe = el.dataset.vibe || '';
        const cardCuisines = el.dataset.cuisines?.split(',').filter((c) => c) || [];
        const cardDietary = el.dataset.dietary?.split(',').filter((d) => d) || [];
        const cardMethods = el.dataset.cookingMethods?.split(',').filter((m) => m) || [];
        const cardOccasions = el.dataset.occasions?.split(',').filter((o) => o) || [];
        const cardFlavors = el.dataset.flavorProfile?.split(',').filter((f) => f) || [];

        const matchesDifficulty = !state.difficulty || cardDifficulty === state.difficulty;
        const matchesRole = !state.role || cardRole === state.role;
        const matchesVibe = !state.vibe || cardVibe === state.vibe;
        const matchesCuisine = !state.cuisine || cardCuisines.includes(state.cuisine);
        const matchesDietary = !state.dietary || cardDietary.includes(state.dietary);
        const matchesMethod = !state.cookingMethod || cardMethods.includes(state.cookingMethod);
        const matchesOccasion = !state.occasion || cardOccasions.includes(state.occasion);
        const matchesFlavor = !state.flavor || cardFlavors.includes(state.flavor);

        const isVisible =
          matchesDifficulty &&
          matchesRole &&
          matchesVibe &&
          matchesCuisine &&
          matchesDietary &&
          matchesMethod &&
          matchesOccasion &&
          matchesFlavor;

        if (isVisible) {
          el.style.display = 'flex';
          visibleCards.push({
            card: el,
            difficulty: cardDifficulty,
            prepTime: el.dataset.prepTime || '',
          });
        } else {
          el.style.display = 'none';
        }
      });
    }

    // Apply sorting
    if (state.sortMode === 'prepTime') {
      visibleCards.sort(
        (a, b) => (timeToMinutes(a.prepTime) ?? Infinity) - (timeToMinutes(b.prepTime) ?? Infinity)
      );
    } else if (state.sortMode === 'difficulty') {
      const diffOrder: Record<string, number> = {
        easy: 0,
        intermediate: 1,
        medium: 1,
        hard: 2,
        advanced: 2,
      };
      visibleCards.sort(
        (a, b) => (diffOrder[a.difficulty] ?? 99) - (diffOrder[b.difficulty] ?? 99)
      );
    }

    if (!state.sortMode || state.sortMode === 'title')
      visibleCards.sort((a, b) =>
        (a.card.querySelector('h2')?.textContent || '').localeCompare(
          b.card.querySelector('h2')?.textContent || ''
        )
      );
    const count = document.getElementById('result-count');
    if (count)
      count.textContent = `${visibleCards.length} recipes${query.trim() ? ` matching “${query.trim()}”` : ''}`;

    // Reorder cards in grid
    const grid = document.getElementById('recipeGrid');
    visibleCards.forEach(({ card }) => grid?.appendChild(card));

    // Toggle no results message
    if (noResults) {
      noResults.style.display = visibleCards.length === 0 ? 'block' : 'none';
    }

    // Synchronize to URL query parameters
    updateUrlParams();
  }

  // Expose globally so FilterPanel can call it
  (window as any).applyFiltersAndSort = applyFiltersAndSort;

  // Search input listener
  searchInput?.addEventListener('input', applyFiltersAndSort);

  function setSelectFromParam(id: string, value: string | null) {
    if (!value) return;
    const select = document.getElementById(id) as HTMLSelectElement | null;
    if (!select) return;
    const hasOption = Array.from(select.options).some((option) => option.value === value);
    if (hasOption) select.value = value;
  }

  function applyInitialUrlState() {
    const params = new URLSearchParams(window.location.search);
    const query = params.get('q') || params.get('search');
    if (query && searchInput) searchInput.value = query;

    setSelectFromParam('filterDifficulty', params.get('difficulty'));
    setSelectFromParam('filterRole', params.get('role'));
    setSelectFromParam('filterVibe', params.get('vibe'));
    setSelectFromParam('filterCuisine', params.get('cuisine'));
    setSelectFromParam('filterDietary', params.get('dietary'));
    setSelectFromParam('filterCookingMethod', params.get('method') || params.get('cookingMethod'));
    setSelectFromParam('filterOccasion', params.get('occasion'));
    setSelectFromParam('filterFlavor', params.get('flavor'));
    setSelectFromParam('sortBy', params.get('sort') || params.get('sortMode'));
  }

  // Clear search button
  clearSearchBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    document.getElementById('resetFilters')?.click();
    applyFiltersAndSort();
    searchInput?.focus();
  });

  // Initial state update and render
  applyInitialUrlState();
  (window as any).updateFilterState?.();
  applyFiltersAndSort();
</script>

<style>
  /* A full-width slate band: the calm Mise blue frame, with apricot only on the one line that matters. */
  .home-hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    padding: 3rem 0 3.5rem;
    margin: -2.5rem 0 1rem;
    align-items: center;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 0 100vmax var(--accent);
    clip-path: inset(0 -100vmax);
  }
  .home-hero .hero-copy .eyebrow {
    color: #e6eef1;
  }
  h1 {
    font:
      650 clamp(2.9rem, 5.2vw, 5rem)/1.12 'Fraunces',
      Georgia,
      serif;
    letter-spacing: -0.03em;
    margin: 1.4rem 0;
  }
  h1 em {
    color: var(--on-apricot);
    background: var(--apricot);
    font-style: italic;
    font-weight: 600;
    padding: 0 0.12em;
    border-radius: 0.12em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .hero-description {
    max-width: 380px;
    color: #f7f6f2;
    line-height: 1.7;
    font-size: 1rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.3rem;
    align-items: center;
    margin-top: 2rem;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .hero-actions a:not(.primary-link) {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .home-hero :focus-visible {
    outline-color: #fff;
  }
  .primary-link {
    background: #fff;
    color: var(--text-primary);
    padding: 0.85rem 1.4rem;
    display: flex;
    gap: 0.8rem;
    font-weight: 700;
    border-radius: var(--pill);
  }
  .hero-study {
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 0;
    border-radius: var(--radius);
    display: block;
    padding: 1.5rem 1.8rem 2rem;
    position: relative;
    box-shadow: 0 10px 30px rgba(20, 35, 44, 0.25);
  }
  .hero-study:hover {
    border-color: var(--accent-gold);
  }
  .study-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .study-arrow {
    color: var(--accent-gold);
    font-size: 1.3rem;
  }
  .study-caption {
    border-top: 1px solid var(--border-emphasis);
    padding-top: 1.6rem;
  }
  .study-caption h2 {
    font:
      650 2.3rem/1.1 'Fraunces',
      Georgia,
      serif;
    margin: 0.8rem 0;
  }
  .study-caption > p:not(.eyebrow) {
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.8;
  }
  .study-foot {
    display: flex;
    justify-content: space-between;
    color: var(--accent-gold);
    font-size: 0.75rem;
    margin-top: 1.5rem;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .section-heading h2,
  .collection-heading h2 {
    font:
      650 clamp(2rem, 3vw, 2.6rem)/1.15 'Fraunces',
      Georgia,
      serif;
    margin: 0.6rem 0;
  }
  .section-heading > a {
    color: var(--accent-gold);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .featured-recipe {
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
  }
  .featured-recipe:hover {
    background: var(--bg-elevated);
  }
  .feature-number {
    font:
      500 2rem 'Fraunces',
      Georgia,
      serif;
    color: var(--text-tertiary);
    margin-bottom: 1.5rem;
  }
  .featured-recipe h3 {
    font:
      650 1.7rem/1.15 'Fraunces',
      Georgia,
      serif;
    margin: 0.8rem 0;
  }
  .featured-recipe > p:not(.eyebrow) {
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .feature-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-top: auto;
    padding-top: 1.5rem;
  }
  .collection-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 4.5rem;
    margin-bottom: 1.8rem;
  }
  .collection-heading p:not(.eyebrow) {
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .collection-search {
    width: 350px;
    max-width: 100%;
    flex-shrink: 0;
  }
  @media (max-width: 850px) {
    .home-hero {
      gap: 2rem;
      grid-template-columns: 1fr 1fr;
    }
    .hero-study {
      padding: 1.2rem;
    }
    .collection-heading {
      flex-direction: column;
      align-items: stretch;
    }
    .collection-search {
      width: 100%;
    }
  }
  @media (max-width: 640px) {
    .home-hero {
      grid-template-columns: 1fr;
      padding-top: 0.5rem;
      gap: 2.5rem;
    }
    .home-hero {
      padding: 2rem 0 2.5rem;
      margin-top: -2.5rem;
    }
    h1 {
      font-size: 2.6rem;
    }
    .hero-study {
      padding: 1.5rem;
    }
    .featured-grid {
      grid-template-columns: 1fr;
    }
    .section-heading {
      align-items: start;
    }
    .feature-number {
      margin-bottom: 0.8rem;
    }
  }
</style>
