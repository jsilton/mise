---
import DishArt from '../components/DishArt.astro';
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import FilterPanel from '../components/FilterPanel.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getCollection } from 'astro:content';
import { getTechniquesForRecipe } from '../data/techniques';
import { timeBand } from '../lib/time-band.mjs';
import { QUICK_PICKS, COURSES, countPicks } from '../lib/quick-picks.mjs';
import type { RecipeSearchItem } from '../lib/fuzzySearch';

const recipes = (await getCollection('recipes')).filter(
  (r) => !['no-cook-playdough', 'play-dough'].includes(r.slug)
);
const BASE = import.meta.env.BASE_URL;
const featuredSlugs = ['authentic-roman-alfredo', 'crispy-parmesan-roasted-broccoli', 'dal-tadka'];
const featured = featuredSlugs.map((slug) => recipes.find((r) => r.slug === slug)).filter(Boolean);
recipes.sort((a, b) => a.data.title.localeCompare(b.data.title));
const { picks, courses, topCuisines } = countPicks(recipes);

// Search matches ingredient names, not amounts: "2 cups (250 g) flour, sifted" → "flour".
const ingredientName = (line: string) =>
  line
    .toLowerCase()
    .replace(/\([^)]*\)/g, ' ')
    .replace(/^[\d\s/.,½¼¾⅓⅔⅛-]+/, '')
    .replace(
      /^(cups?|tablespoons?|tbsp|teaspoons?|tsp|pounds?|lbs?|ounces?|oz|grams?|g|kg|ml|liters?|l|cloves?|pinch|dash|cans?|large|medium|small|whole|bunch)\b\.?\s*/g,
      ''
    )
    .split(',')[0]
    .replace(/\s+/g, ' ')
    .trim();

const searchIndexData: RecipeSearchItem[] = recipes.map((recipe) => ({
  slug: recipe.slug,
  title: recipe.data.title,
  cuisines: recipe.data.cuisines,
  ingredients: [
    ...new Set(
      (recipe.data.ingredients || [])
        .filter((line) => !/^---/.test(line))
        .map(ingredientName)
        .filter(Boolean)
    ),
  ],
  flavorProfile: recipe.data.flavorProfile,
  cookingMethods: [
    ...(recipe.data.cookingMethods || []),
    ...getTechniquesForRecipe(recipe).map((t) => t.title),
    ...(recipe.data.learning ? [recipe.data.learning.focus] : []),
  ],
  origin: recipe.data.origin,
}));
---

<Layout
  title="Mise | Cook with understanding"
  description="The family recipe box. Find tonight's dinner by course, occasion, cuisine or time, then learn why it works."
>
  <section class="finder-hero" aria-labelledby="home-title">
    <p class="eyebrow hero-eyebrow">The family recipe box · {recipes.length} recipes</p>
    <h1 id="home-title">What are we <em>cooking</em>?</h1>
    <div class="hero-search" role="search">
      <SearchBar id="searchInput" placeholder="Dal, tacos, chicken, browning…" />
    </div>
    <ul class="chips" role="list" aria-label="Quick picks, choose any">
      {
        QUICK_PICKS.map((p) => (
          <li>
            <button type="button" class="chip" data-pick={p.key} aria-pressed="false">
              <span class="lbl">{p.label}</span>
              <span class="n">{picks[p.key]}</span>
            </button>
          </li>
        ))
      }
    </ul>
    <div class="hero-actions">
      <a class="see-results" id="heroCount" href="#collection">
        See all {recipes.length} recipes <span aria-hidden="true">↓</span>
      </a>
      <button type="button" class="surprise" data-surprise>Surprise me</button>
    </div>
  </section>

  <section class="browse" aria-labelledby="course-title">
    <h2 class="sec-h" id="course-title">Pick a course</h2>
    <ul class="courses" role="list" aria-label="Course">
      {
        COURSES.map((c) => (
          <li>
            <button type="button" data-course={c.key} aria-pressed="false">
              <span class="lbl">{c.label}</span>
              <span class="n">{courses[c.key]}</span>
            </button>
          </li>
        ))
      }
    </ul>
    <p class="legend">
      <span class="legend-label">Total time</span>
      <span class="time-chip" data-band="quick">30 min or less</span>
      <span class="time-chip" data-band="hour">Up to an hour</span>
      <span class="time-chip" data-band="long">Longer</span>
    </p>
  </section>

  <section id="collection" class="collection" aria-labelledby="result-count">
    <div class="list-head">
      <h2 id="result-count" class="count" aria-live="polite">All {recipes.length} recipes</h2>
      <label class="sort">
        <span>Sort</span>
        <select id="sortBy">
          <option value="pick">Mixed</option>
          <option value="time">Quickest first</option>
          <option value="difficulty">Easiest first</option>
          <option value="title">A to Z</option>
        </select>
      </label>
    </div>
    <div id="activeFilters" class="active-filters"></div>
    <details class="more-filters">
      <summary
        >More filters <span class="hint">difficulty, cuisine, diet, method, flavor</span></summary
      >
      <FilterPanel {recipes} />
    </details>

    <div id="recipeGrid" class="recipe-grid">
      {recipes.map((recipe) => <RecipeCard {recipe} />)}
    </div>
    <button type="button" id="showMore" class="show-more" hidden>Show more recipes</button>

    <div id="noResults" class="no-results" hidden>
      <h3>Nothing matches all of those.</h3>
      <p>Try removing a filter, or search for one ingredient.</p>
      <button id="clearSearch" type="button">Clear search and filters</button>
    </div>
  </section>

  <section class="cuisine-band" aria-labelledby="cuisine-title">
    <h2 class="sec-h" id="cuisine-title">Around the world</h2>
    <ul class="cuisines" role="list" aria-label="Cuisine">
      {
        topCuisines.map(([name, n]) => (
          <li>
            <button type="button" data-cuisine={name} aria-pressed="false">
              <span class="lbl">{name}</span>
              <span class="n">{n}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="featured-section" aria-labelledby="featured-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Cook something. Learn something.</p>
        <h2 id="featured-title">Three recipes, three useful lessons.</h2>
      </div>
      <a href={`${BASE}learn`}>All lessons ↗</a>
    </div>
    <div class="featured-grid">
      {
        featured.map((recipe) => (
          <a class="featured-recipe" href={`${BASE}recipes/${recipe.slug}`}>
            <DishArt slug={recipe.slug} />
            <div class="featured-body">
              <p class="eyebrow">{recipe.data.learning.focus}</p>
              <h3>{recipe.data.title}</h3>
              <p>{recipe.data.learning.outcome}</p>
              <span class="feature-meta">
                <span class="time-chip" data-band={timeBand(recipe.data.totalTime).band}>
                  {timeBand(recipe.data.totalTime).short || recipe.data.totalTime}
                </span>
                <span class="capitalize">{recipe.data.difficulty}</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="closer" aria-labelledby="closer-title">
    <h2 id="closer-title">Can't decide? <span>Let Mise pick.</span></h2>
    <button type="button" class="surprise" data-surprise>Surprise me</button>
  </section>
</Layout>

<script define:vars={{ searchIndexData }}>
  window.__searchIndexData = searchIndexData;
</script>

<script>
  import Fuse from 'fuse.js';

  const PAGE = 12;
  const searchIndexData = (window as any).__searchIndexData;
  const fuse = new Fuse(searchIndexData, {
    keys: [
      { name: 'title', weight: 10 },
      { name: 'ingredients', weight: 5 },
      { name: 'cuisines', weight: 3 },
      { name: 'flavorProfile', weight: 2 },
      { name: 'cookingMethods', weight: 2 },
      { name: 'origin', weight: 2 },
    ],
    threshold: 0.35,
    minMatchCharLength: 2,
    ignoreLocation: true,
  });

  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const $$ = <T extends Element = HTMLElement>(sel: string) =>
    Array.from(document.querySelectorAll<T>(sel));

  const searchInput = $<HTMLInputElement>('#searchInput');
  const grid = $('#recipeGrid')!;
  const cards = $$<HTMLAnchorElement>('#recipeGrid .recipe-card');
  const sortSelect = $<HTMLSelectElement>('#sortBy')!;
  const showMore = $<HTMLButtonElement>('#showMore')!;
  const countEl = $('#result-count')!;
  const heroCount = $('#heroCount')!;
  const active = $('#activeFilters')!;
  const noResults = $('#noResults')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The selects in "More filters" stay the source of truth for single-choice filters,
  // so the course and cuisine buttons simply set them.
  const SELECTS: Record<string, { id: string; param: string; label: string }> = {
    role: { id: 'filterRole', param: 'role', label: 'Course' },
    cuisine: { id: 'filterCuisine', param: 'cuisine', label: 'Cuisine' },
    difficulty: { id: 'filterDifficulty', param: 'difficulty', label: 'Level' },
    vibe: { id: 'filterVibe', param: 'vibe', label: 'Vibe' },
    dietary: { id: 'filterDietary', param: 'dietary', label: 'Diet' },
    cookingMethod: { id: 'filterCookingMethod', param: 'method', label: 'Method' },
    occasion: { id: 'filterOccasion', param: 'occasion', label: 'Occasion' },
    flavor: { id: 'filterFlavor', param: 'flavor', label: 'Flavor' },
  };
  const select = (key: string) => document.getElementById(SELECTS[key].id) as HTMLSelectElement;

  const picks = new Set<string>();
  let shown = PAGE;

  type CardInfo = {
    el: HTMLAnchorElement;
    slug: string;
    title: string;
    minutes: number;
    difficulty: string;
    picks: string[];
    hasArt: boolean;
    rank: number;
    data: DOMStringMap;
  };
  const hash = (s: string) => {
    let h = 7;
    for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 100003;
    return h;
  };
  const info: CardInfo[] = cards.map((el) => {
    const slug = el.getAttribute('href')?.split('/').filter(Boolean).pop() || '';
    return {
      el,
      slug,
      title: el.dataset.title || '',
      minutes: Number(el.dataset.minutes) || 0,
      difficulty: el.dataset.difficulty || '',
      picks: (el.dataset.picks || '').split(',').filter(Boolean),
      hasArt: !!el.querySelector('.dish-art'),
      rank: hash(slug),
      data: el.dataset,
    };
  });
  const DIFF: Record<string, number> = {
    easy: 0,
    intermediate: 1,
    medium: 1,
    hard: 2,
    advanced: 2,
  };
  const list = (v?: string) => (v || '').split(',').filter(Boolean);

  function matches(c: CardInfo, searchHits: Set<string> | null) {
    if (searchHits && !searchHits.has(c.slug)) return false;
    for (const p of picks) if (!c.picks.includes(p)) return false;
    const st = (window as any).filterState || {};
    const d = c.data;
    if (st.difficulty && d.difficulty !== st.difficulty) return false;
    if (st.role && d.role !== st.role) return false;
    if (st.vibe && d.vibe !== st.vibe) return false;
    if (st.cuisine && !list(d.cuisines).includes(st.cuisine)) return false;
    if (st.dietary && !list(d.dietary).includes(st.dietary)) return false;
    if (st.cookingMethod && !list(d.cookingMethods).includes(st.cookingMethod)) return false;
    if (st.occasion && !list(d.occasions).includes(st.occasion)) return false;
    if (st.flavor && !list(d.flavorProfile).includes(st.flavor)) return false;
    return true;
  }

  function sortCards(items: CardInfo[], mode: string) {
    const byTitle = (a: CardInfo, b: CardInfo) => a.title.localeCompare(b.title);
    const byTime = (a: CardInfo, b: CardInfo) => (a.minutes || 1e9) - (b.minutes || 1e9);
    if (mode === 'title') return items.sort(byTitle);
    if (mode === 'time') return items.sort((a, b) => byTime(a, b) || byTitle(a, b));
    if (mode === 'difficulty')
      return items.sort(
        (a, b) => (DIFF[a.difficulty] ?? 9) - (DIFF[b.difficulty] ?? 9) || byTime(a, b)
      );
    // Mixed: painted recipes first, then a stable shuffle so the page isn't all "A".
    return items.sort((a, b) => Number(b.hasArt) - Number(a.hasArt) || a.rank - b.rank);
  }

  function currentMatches() {
    const query = searchInput?.value.trim() || '';
    const hits = query ? new Set<string>(fuse.search(query).map((r: any) => r.item.slug)) : null;
    return { query, items: info.filter((c) => matches(c, hits)) };
  }

  function labelFor(key: string) {
    const s = select(key);
    return s?.selectedOptions[0]?.textContent?.trim() || s?.value || '';
  }

  function render() {
    (window as any).updateFilterState?.();
    const { query, items } = currentMatches();
    const sorted =
      query && sortSelect.value === 'pick' ? items : sortCards(items, sortSelect.value);
    if (query && sortSelect.value === 'pick') {
      // With a search, Mixed keeps the best matches first.
      const order = new Map(fuse.search(query).map((r: any, i: number) => [r.item.slug, i]));
      sorted.sort((a, b) => (order.get(a.slug) ?? 1e9) - (order.get(b.slug) ?? 1e9));
    }
    const visible = new Set(sorted.slice(0, shown).map((c) => c.el));
    info.forEach((c) => (c.el.style.display = visible.has(c.el) ? 'flex' : 'none'));
    sorted.forEach((c) => grid.appendChild(c.el));

    const n = sorted.length;
    const filtered = n !== info.length;
    countEl.textContent = filtered
      ? `${n} recipe${n === 1 ? '' : 's'}${query ? ` for “${query}”` : ''}`
      : `All ${n} recipes`;
    heroCount.innerHTML = `${filtered ? `See ${n} recipe${n === 1 ? '' : 's'}` : `See all ${n} recipes`} <span aria-hidden="true">↓</span>`;
    showMore.hidden = n <= shown;
    showMore.textContent = `Show more recipes (${n - Math.min(n, shown)} left)`;
    noResults.hidden = n !== 0;

    $$('[data-pick]').forEach((b) =>
      b.setAttribute('aria-pressed', String(picks.has(b.dataset.pick!)))
    );
    const st = (window as any).filterState || {};
    $$('[data-course]').forEach((b) =>
      b.setAttribute('aria-pressed', String(st.role === b.dataset.course))
    );
    $$('[data-cuisine]').forEach((b) =>
      b.setAttribute('aria-pressed', String(st.cuisine === b.dataset.cuisine))
    );

    const bits: string[] = [];
    const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => `&#${ch.charCodeAt(0)};`);
    if (query)
      bits.push(
        `<button type="button" data-unset="q">“${esc(query)}” <span aria-hidden="true">×</span><span class="sr-only"> (clear search)</span></button>`
      );
    picks.forEach((p) => {
      const lbl = $(`[data-pick="${p}"] .lbl`)?.textContent || p;
      bits.push(
        `<button type="button" data-unset="pick" data-value="${p}">${esc(lbl)} <span aria-hidden="true">×</span><span class="sr-only"> (remove filter)</span></button>`
      );
    });
    Object.keys(SELECTS).forEach((k) => {
      if (st[k])
        bits.push(
          `<button type="button" data-unset="${k}">${esc(labelFor(k))} <span aria-hidden="true">×</span><span class="sr-only"> (remove ${SELECTS[k].label.toLowerCase()} filter)</span></button>`
        );
    });
    if (bits.length > 1)
      bits.push('<button type="button" class="clear" data-clear>Clear all</button>');
    active.innerHTML = bits.join(' ');

    updateUrl(query, st);
  }

  function updateUrl(query: string, st: Record<string, string>) {
    const params = new URLSearchParams();
    if (query) params.set('q', query);
    if (picks.size) params.set('picks', [...picks].join(','));
    Object.entries(SELECTS).forEach(([k, s]) => st[k] && params.set(s.param, st[k]));
    if (sortSelect.value !== 'pick') params.set('sort', sortSelect.value);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}#collection` : window.location.pathname);
  }

  const goToResults = () =>
    $('#collection')?.scrollIntoView({
      behavior: reduceMotion ? 'auto' : 'smooth',
      block: 'start',
    });
  const reset = () => {
    shown = PAGE;
    render();
  };
  const setSelect = (key: string, value: string) => {
    const s = select(key);
    if (s) s.value = Array.from(s.options).some((o) => o.value === value) ? value : '';
  };

  // FilterPanel calls this when one of its selects changes.
  (window as any).applyFiltersAndSort = reset;

  document.addEventListener('click', (ev) => {
    const t = ev.target as HTMLElement;
    const pick = t.closest<HTMLElement>('[data-pick]');
    if (pick) {
      const k = pick.dataset.pick!;
      picks.has(k) ? picks.delete(k) : picks.add(k);
      return reset();
    }
    const course = t.closest<HTMLElement>('[data-course]');
    if (course) {
      const on = select('role')?.value === course.dataset.course;
      setSelect('role', on ? '' : course.dataset.course!);
      reset();
      if (!on) goToResults();
      return;
    }
    const cuisine = t.closest<HTMLElement>('[data-cuisine]');
    if (cuisine) {
      const on = select('cuisine')?.value === cuisine.dataset.cuisine;
      setSelect('cuisine', on ? '' : cuisine.dataset.cuisine!);
      reset();
      if (!on) goToResults();
      return;
    }
    const unset = t.closest<HTMLElement>('[data-unset]');
    if (unset) {
      const k = unset.dataset.unset!;
      if (k === 'q' && searchInput) searchInput.value = '';
      else if (k === 'pick') picks.delete(unset.dataset.value!);
      else setSelect(k, '');
      return reset();
    }
    if (t.closest('[data-clear]') || t.closest('#clearSearch')) {
      if (searchInput) searchInput.value = '';
      picks.clear();
      Object.keys(SELECTS).forEach((k) => setSelect(k, ''));
      reset();
      if (t.closest('#clearSearch')) searchInput?.focus();
      return;
    }
    if (t.closest('[data-surprise]')) {
      const pool = currentMatches().items;
      const from = pool.length ? pool : info;
      const choice = from[Math.floor(Math.random() * from.length)];
      window.location.href = choice.el.href;
    }
  });

  showMore.addEventListener('click', () => {
    const firstNew = shown;
    shown += PAGE;
    render();
    const next = Array.from(grid.children).filter(
      (el) => (el as HTMLElement).style.display !== 'none'
    )[firstNew] as HTMLElement | undefined;
    next?.focus({ preventScroll: true });
  });
  sortSelect.addEventListener('change', reset);

  let timer: number | undefined;
  searchInput?.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(reset, 150);
  });
  searchInput?.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Enter') return;
    ev.preventDefault();
    clearTimeout(timer);
    reset();
    searchInput.blur();
    goToResults();
  });

  function applyInitialUrlState() {
    const params = new URLSearchParams(window.location.search);
    const query = params.get('q') || params.get('search');
    if (query && searchInput) searchInput.value = query;
    (params.get('picks') || '')
      .split(',')
      .forEach((p) => p && $(`[data-pick="${p}"]`) && picks.add(p));
    Object.entries(SELECTS).forEach(([k, s]) => {
      const v = params.get(s.param) || (k === 'cookingMethod' ? params.get('cookingMethod') : null);
      if (v) setSelect(k, v);
    });
    const sort = params.get('sort') || params.get('sortMode');
    const legacy: Record<string, string> = { prepTime: 'time' };
    const mode = sort ? legacy[sort] || sort : '';
    if (mode && Array.from(sortSelect.options).some((o) => o.value === mode))
      sortSelect.value = mode;
    // Open "More filters" when the link set one of its filters.
    if (
      ['difficulty', 'vibe', 'dietary', 'cookingMethod', 'occasion', 'flavor'].some(
        (k) => select(k)?.value
      )
    )
      $<HTMLDetailsElement>('.more-filters')!.open = true;
  }

  applyInitialUrlState();
  render();
</script>

<style>
  /* The hero is the finder: one question, one search box, and the everyday quick picks. */
  .finder-hero {
    margin: -2.5rem 0 0;
    padding: 2.6rem 0 2.4rem;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 0 100vmax var(--accent);
    clip-path: inset(0 -100vmax);
    text-align: center;
  }
  .hero-eyebrow {
    color: #e6eef1;
  }
  h1 {
    font:
      650 clamp(2.6rem, 6vw, 4.6rem)/1.08 'Fraunces',
      Georgia,
      serif;
    letter-spacing: -0.03em;
    margin: 0.8rem 0 1.4rem;
  }
  h1 em {
    color: var(--on-apricot);
    background: var(--apricot);
    font-style: italic;
    font-weight: 600;
    padding: 0 0.14em;
    border-radius: 0.14em;
  }
  .hero-search {
    max-width: 620px;
    margin: 0 auto;
    color: var(--text-primary);
  }
  .hero-search :global(.search-input) {
    padding-top: 1rem;
    padding-bottom: 1rem;
    font-size: 1.05rem;
    border: 0 !important;
    box-shadow: 0 8px 24px rgba(20, 35, 44, 0.22);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    max-width: 820px;
    margin: 1.2rem auto 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.45rem 1rem;
    border-radius: var(--pill);
    border: 2px solid rgba(255, 255, 255, 0.75);
    background: transparent;
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .chip:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .chip[aria-pressed='true'] {
    background: #fff;
    border-color: #fff;
    color: var(--text-primary);
  }
  .chip[aria-pressed='true']::before {
    content: '✓';
  }
  .n {
    font-weight: 500;
    opacity: 0.75;
    font-size: 0.85em;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem 1.4rem;
    align-items: center;
    margin-top: 1.4rem;
  }
  .see-results {
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .surprise {
    min-height: 44px;
    padding: 0.6rem 1.3rem;
    border-radius: var(--pill);
    background: #fff;
    color: var(--text-primary);
    font-weight: 700;
  }
  .finder-hero :focus-visible {
    outline-color: #fff;
  }

