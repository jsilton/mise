{
  "name": "mise",
  "version": "1.0.0",
  "description": "The version-controlled culinary standard for the Master Kitchen.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "new-recipe": "node ./scripts/new-recipe.mjs",
    "pin:paprika": "node scripts/pin-paprika-ids.mjs",
    "check:paprika-privacy": "node scripts/check-paprika-privacy.mjs dist",
    "validate-recipes": "node ./scripts/validate-recipes.mjs",
    "culinary-qa": "node ./scripts/culinary-qa.mjs",
    "qa": "node ./scripts/qa-test.mjs",
    "deploy": "npm run qa && npm run build && echo 'Ready to deploy - push /dist/ to production'",
    "prepare": "husky || true",
    "lint-recipe": "node ./scripts/lint-recipe.mjs",
    "lint-recipe:staged": "node ./scripts/lint-recipe.mjs --staged",
    "export:paprika": "node scripts/export-paprika.mjs",
    "export:jsonld": "node scripts/export-jsonld.mjs",
    "precommit": "npm run validate-recipes && npm run lint-recipe:staged",
    "test": "node --test scripts/tests/*.test.mjs",
    "editorial-audit": "node scripts/recipe-editorial.mjs",
    "recipe:compile": "node scripts/compile-recipe-formulas.mjs",
    "prebuild": "node scripts/compile-recipe-formulas.mjs --check",
    "export:text": "node scripts/export-text.mjs",
    "export:check": "node scripts/check-exports.mjs",
    "check:copy": "node ./scripts/check-recipe-copy.mjs"
  },
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.18.2",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^3.4.19",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1"
  },
  "lint-staged": {
    "src/content/recipes/**/*.md": [
      "npm run validate-recipes",
      "node ./scripts/lint-recipe.mjs",
      "node ./scripts/check-recipe-copy.mjs"
    ],
    "*.{js,mjs,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
